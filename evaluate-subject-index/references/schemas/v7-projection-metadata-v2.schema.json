{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v7-projection-metadata-v2.schema.json",
  "title": "V7 result, web, and score-view projection metadata",
  "type": "object",
  "required": ["schema_version", "candidate_label", "inclusion_policy", "uncertainty_policy", "critical_gates", "canonical_calculation", "canonical_structure_locator_review", "projection_metadata_sha256"],
  "properties": {
    "schema_version": {"const": "subject-index-v7-projection-metadata-v2"},
    "candidate_label": {"type": "string", "minLength": 1},
    "inclusion_policy": {"type": "string", "minLength": 1},
    "uncertainty_policy": {"type": "string", "minLength": 1},
    "critical_gates": {"type": "array", "items": {"type": "object"}},
    "report_id": {"type": "string"},
    "headline": {"type": "string"},
    "summary": {"type": "string"},
    "interpretation": {"type": "string"},
    "defect_counts": {"type": "object"},
    "strengths": {"type": "array", "items": {"type": "object"}},
    "defects": {"type": "array", "items": {"type": "object"}},
    "examples": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "canonical_calculation": {"$ref": "#/$defs/calculationReference"},
    "canonical_structure_locator_review": {"$ref": "#/$defs/reviewReference"},
    "canonical_locator_fit_supplement": {"$ref": "#/$defs/fitSupplementReference"},
    "counterfactual_score_views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["view_id", "label", "calculation", "structure_locator_review", "provenance_artifacts"],
        "properties": {
          "view_id": {"type": "string", "minLength": 1, "not": {"const": "canonical_as_delivered"}},
          "label": {"type": "string", "minLength": 1},
          "calculation": {"$ref": "#/$defs/calculationReference"},
          "structure_locator_review": {"$ref": "#/$defs/reviewReference"},
          "locator_fit_supplement": {"$ref": "#/$defs/fitSupplementReference"},
          "provenance_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactReference"}}
        },
        "additionalProperties": false
      }
    },
    "projection_metadata_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifactReference": {
      "type": "object",
      "required": ["role", "schema_version", "artifact_path", "sha256"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "artifact_path": {"$ref": "score-migration.schema.json#/$defs/portablePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "calculationReference": {
      "type": "object",
      "required": ["schema_version", "artifact_path", "sha256", "calculation_sha256", "rubric_version", "calculation_profile"],
      "properties": {
        "schema_version": {"const": "subject-index-dimension-calculations-v4"},
        "artifact_path": {"$ref": "score-migration.schema.json#/$defs/portablePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "calculation_sha256": {"$ref": "#/$defs/sha256"},
        "rubric_version": {"const": "subject-index-rubric-v7"},
        "calculation_profile": {"const": "subject-index-dimension-calculation-v3"}
      },
      "additionalProperties": false
    },
    "reviewReference": {
      "type": "object",
      "required": ["schema_version", "artifact_path", "sha256", "review_sha256"],
      "properties": {
        "schema_version": {"const": "subject-index-structure-locator-review-v1"},
        "artifact_path": {"$ref": "score-migration.schema.json#/$defs/portablePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "review_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "fitSupplementReference": {
      "type": "object",
      "description": "Projection reference to an exact-scope, score-free complete-path-fit supplement; the supplement may resolve an eligible legacy structured fit conflict without modifying historical records.",
      "required": ["schema_version", "artifact_path", "sha256", "supplement_id", "supplement_sha256", "unresolved_set_sha256", "decision_count"],
      "properties": {
        "schema_version": {"enum": ["subject-index-v7-locator-fit-supplement-v1", "subject-index-v7-locator-fit-supplement-v2"]},
        "artifact_path": {"$ref": "score-migration.schema.json#/$defs/portablePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "supplement_id": {"type": "string", "pattern": "^FITSUP-[A-F0-9]{12}$"},
        "supplement_sha256": {"$ref": "#/$defs/sha256"},
        "unresolved_set_sha256": {"$ref": "#/$defs/sha256"},
        "decision_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
