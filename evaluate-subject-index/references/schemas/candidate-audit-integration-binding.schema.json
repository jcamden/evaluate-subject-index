{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-audit-integration-binding.schema.json",
  "title": "Explicit private candidate-audit integration binding",
  "type": "object",
  "required": ["schema_version", "audit_kind", "candidate_project", "selection", "receipt", "recovery", "public_report", "open_pr_evidence"],
  "properties": {
    "schema_version": {"const": "candidate-audit-integration-binding-v1"},
    "audit_kind": {"enum": ["locator_audit", "missing_access"]},
    "candidate_project": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$", "maxLength": 256},
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "pull_request", "pull_request_url"],
          "properties": {
            "type": {"const": "pull_request"},
            "pull_request": {"type": "integer", "minimum": 1},
            "pull_request_url": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[1-9][0-9]*$"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "branch"],
          "properties": {
            "type": {"const": "branch"},
            "branch": {"type": "string", "pattern": "^(?:locator-audit|missing-access-audit)/chunk-[a-z0-9._-]+$"}
          },
          "additionalProperties": false
        }
      ]
    },
    "receipt": {"$ref": "#/$defs/fileBinding"},
    "recovery": {
      "type": "object",
      "required": ["root", "archive_path", "archive_sha256"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "archive_path": {"type": "string", "minLength": 1},
        "archive_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "public_report": {"$ref": "#/$defs/fileBinding"},
    "open_pr_evidence": {"$ref": "#/$defs/fileBinding"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fileBinding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
