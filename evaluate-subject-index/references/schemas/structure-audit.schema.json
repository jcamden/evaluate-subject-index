{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structure-audit.schema.json",
  "title": "Global subject index structure audit",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "candidate_sha256", "item_inventory_sha256", "scope_complete", "metrics", "density", "expected_node_ids", "node_judgments", "expected_cross_reference_ids", "cross_reference_judgments", "defects", "strengths", "completion"],
  "properties": {
    "schema_version": {"const": "structure-audit-v3"},
    "evaluation_id": {"type": "string"},
    "candidate_sha256": {"type": "string"},
    "item_inventory_sha256": {"type": "string"},
    "scope_complete": {"type": "boolean"},
    "metrics": {
      "type": "object",
      "required": ["page_bearing_paths", "expanded_locators", "cross_references"],
      "additionalProperties": true
    },
    "density": {
      "type": "object",
      "required": ["policy_status", "measurement_level", "targets", "chapter_measurements", "fit_rating", "maximum_score_contribution", "distribution_findings"],
      "properties": {
        "policy_status": {"const": "scored"},
        "measurement_level": {"const": "chapter_or_approved_intellectual_unit"},
        "targets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "object"}
        },
        "chapter_measurements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["chunk_id", "indexable_source_words", "locator_bearing_heading_paths", "locator_occurrences", "metric_results", "unit_fit_rating"],
            "additionalProperties": true
          }
        },
        "fit_rating": {"type": ["number", "null"], "minimum": 0, "maximum": 5, "multipleOf": 0.5},
        "maximum_score_contribution": {"const": 5},
        "distribution_findings": {"type": "array", "items": {"type": "object"}}
      }
    },
    "expected_node_ids": {"type": "array", "items": {"type": "string", "pattern": "^NODE-"}, "uniqueItems": true},
    "node_judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "heading_path", "role", "component_judgments", "summary", "confidence", "evidence_ids"],
        "properties": {
          "node_id": {"type": "string", "pattern": "^NODE-"},
          "heading_path": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "role": {"enum": ["main_heading", "subheading"]},
          "component_judgments": {
            "type": "object",
            "required": ["conceptual_stance_fidelity", "heading_access_architecture", "mechanics_consistency"],
            "properties": {
              "conceptual_stance_fidelity": {"$ref": "#/$defs/componentJudgment"},
              "heading_access_architecture": {"$ref": "#/$defs/componentJudgment"},
              "mechanics_consistency": {"$ref": "#/$defs/componentJudgment"}
            },
            "additionalProperties": false
          },
          "summary": {"type": "string"},
          "confidence": {"enum": ["high", "medium", "low"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": true
      }
    },
    "expected_cross_reference_ids": {"type": "array", "items": {"type": "string", "pattern": "^XREF-"}, "uniqueItems": true},
    "cross_reference_judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reference_id", "judgment", "summary", "severity", "confidence", "evidence_ids"],
        "properties": {
          "reference_id": {"type": "string", "pattern": "^XREF-"},
          "judgment": {"enum": ["supported", "partially_supported", "unsupported", "uninspectable"]},
          "summary": {"type": "string"},
          "severity": {"enum": ["none", "cosmetic", "minor", "major", "critical"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": true
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["defect_id", "code", "severity", "summary", "affected_ids"],
        "properties": {
          "defect_id": {"type": "string", "pattern": "^DEFECT-"},
          "code": {"enum": ["SCP", "COV", "SEL", "CON", "STA", "LOC_POS", "LOC_NEG", "CMP", "HED", "SUB", "XRF", "DEN", "MEC"]},
          "severity": {"enum": ["cosmetic", "minor", "major", "critical"]},
          "summary": {"type": "string"},
          "affected_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "strengths": {"type": "array", "items": {"type": "object"}},
    "completion": {
      "type": "object",
      "required": ["expected_nodes", "judged_nodes", "expected_cross_references", "judged_cross_references", "complete"],
      "properties": {
        "expected_nodes": {"type": "integer", "minimum": 0},
        "judged_nodes": {"type": "integer", "minimum": 0},
        "expected_cross_references": {"type": "integer", "minimum": 0},
        "judged_cross_references": {"type": "integer", "minimum": 0},
        "complete": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "componentJudgment": {
      "type": "object",
      "required": ["status", "summary", "evidence_ids"],
      "properties": {
        "status": {"enum": ["passes", "minor_issues", "major_issues", "fails", "uninspectable", "not_applicable"]},
        "summary": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
