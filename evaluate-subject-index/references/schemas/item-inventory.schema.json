{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "item-inventory.schema.json",
  "title": "Stable display-item inventory for a normalized subject index",
  "type": "object",
  "required": ["schema_version", "candidate_id", "candidate_sha256", "paths", "heading_nodes", "locators", "cross_references", "counts"],
  "properties": {
    "schema_version": {"const": "subject-index-item-inventory-v1"},
    "candidate_id": {"type": "string"},
    "candidate_sha256": {"type": "string"},
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path_id", "record_id", "record_type", "heading_path", "node_ids", "locator_ids", "reference_id"],
        "properties": {
          "path_id": {"type": "string", "pattern": "^PATH-"},
          "record_id": {"type": "string"},
          "record_type": {"enum": ["page_bearing", "container", "cross_reference"]},
          "heading_path": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string"}},
          "node_ids": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "pattern": "^NODE-"}, "uniqueItems": true},
          "locator_ids": {"type": "array", "items": {"type": "string", "pattern": "^LOC-"}, "uniqueItems": true},
          "reference_id": {"type": ["string", "null"], "pattern": "^XREF-"}
        },
        "additionalProperties": true
      }
    },
    "heading_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "level", "role", "label", "heading_path", "parent_node_id", "path_ids", "record_ids", "direct_path_ids"],
        "properties": {
          "node_id": {"type": "string", "pattern": "^NODE-"},
          "level": {"enum": [1, 2]},
          "role": {"enum": ["main_heading", "subheading"]},
          "label": {"type": "string"},
          "heading_path": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string"}},
          "parent_node_id": {"type": ["string", "null"], "pattern": "^NODE-"},
          "path_ids": {"type": "array", "items": {"type": "string", "pattern": "^PATH-"}, "uniqueItems": true},
          "record_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "direct_path_ids": {"type": "array", "items": {"type": "string", "pattern": "^PATH-"}, "uniqueItems": true}
        },
        "additionalProperties": true
      }
    },
    "locators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["locator_id", "path_id", "node_ids", "source_page_label", "document_page", "mapping_status"],
        "properties": {
          "locator_id": {"type": "string", "pattern": "^LOC-"},
          "path_id": {"type": "string", "pattern": "^PATH-"},
          "node_ids": {"type": "array", "items": {"type": "string", "pattern": "^NODE-"}},
          "source_page_label": {"type": "string"},
          "document_page": {"type": ["integer", "null"]},
          "mapping_status": {"enum": ["resolved", "unresolved", "ambiguous"]}
        },
        "additionalProperties": true
      }
    },
    "cross_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reference_id", "record_id", "source_path_id", "source_node_id", "reference_type", "target_display", "target_path_id"],
        "properties": {
          "reference_id": {"type": "string", "pattern": "^XREF-"},
          "source_path_id": {"type": "string", "pattern": "^PATH-"},
          "source_node_id": {"type": "string", "pattern": "^NODE-"},
          "reference_type": {"enum": ["see", "see also"]},
          "target_display": {"type": "string"},
          "target_path_id": {"type": ["string", "null"], "pattern": "^PATH-"}
        },
        "additionalProperties": true
      }
    },
    "counts": {
      "type": "object",
      "required": ["paths", "heading_nodes", "locators", "cross_references"],
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  },
  "additionalProperties": true
}
