{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "locator-audit-batch-integration.schema.json",
  "title": "Private locator-audit batch integration report",
  "type": "object",
  "required": [
    "schema_version", "integration_id", "integration_sha256", "audit_kind", "status",
    "integrated_at", "evaluation_id", "candidate_id", "candidate_project", "base_branch",
    "identities", "selected_workers", "coverage", "transaction_order", "manifest_before_sha256",
    "manifest_after_sha256", "state_before_sha256", "state_after_sha256", "stage_status",
    "checkpoint", "benchmark_repository_modified"
  ],
  "properties": {
    "schema_version": {"const": "locator-audit-batch-integration-v1"},
    "integration_id": {"type": "string", "pattern": "^LABI-[A-F0-9]{12}$"},
    "integration_sha256": {"$ref": "#/$defs/sha256"},
    "audit_kind": {"const": "locator_audit"},
    "status": {"enum": ["integrated_partial", "integrated_complete", "idempotent"]},
    "integrated_at": {"type": "string", "format": "date-time"},
    "evaluation_id": {"$ref": "#/$defs/boundedString"},
    "candidate_id": {"$ref": "#/$defs/boundedString"},
    "candidate_project": {"$ref": "#/$defs/project"},
    "base_branch": {"$ref": "#/$defs/boundedString"},
    "identities": {"$ref": "#/$defs/identities"},
    "selected_workers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/selectedWorker"}
    },
    "coverage": {
      "type": "object",
      "required": ["expected_chunk_ids", "previously_integrated_chunk_ids", "selected_chunk_ids", "active_chunk_ids", "missing_chunk_ids", "expected_assignments", "accepted_assignments", "duplicate_assignments", "foreign_assignments"],
      "properties": {
        "expected_chunk_ids": {"$ref": "#/$defs/chunkIds"},
        "previously_integrated_chunk_ids": {"$ref": "#/$defs/chunkIds"},
        "selected_chunk_ids": {"$ref": "#/$defs/chunkIds"},
        "active_chunk_ids": {"$ref": "#/$defs/chunkIds"},
        "missing_chunk_ids": {"$ref": "#/$defs/chunkIds"},
        "expected_assignments": {"type": "integer", "minimum": 0},
        "accepted_assignments": {"type": "integer", "minimum": 0},
        "duplicate_assignments": {"const": 0},
        "foreign_assignments": {"const": 0}
      },
      "additionalProperties": false
    },
    "transaction_order": {"$ref": "#/$defs/transactionOrder"},
    "manifest_before_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_after_sha256": {"$ref": "#/$defs/sha256"},
    "state_before_sha256": {"$ref": "#/$defs/sha256"},
    "state_after_sha256": {"$ref": "#/$defs/sha256"},
    "stage_status": {"enum": ["in_progress", "completed"]},
    "checkpoint": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "benchmark_repository_modified": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commit": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"},
    "boundedString": {"type": "string", "minLength": 1, "maxLength": 256},
    "project": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$", "maxLength": 256},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "chunkIds": {"type": "array", "items": {"type": "string", "pattern": "^CHUNK-[A-Za-z0-9._-]+$"}, "uniqueItems": true},
    "identities": {
      "type": "object",
      "required": ["source_sha256", "candidate_sha256", "benchmark_sha256", "benchmark_lock_sha256", "policy_sha256", "page_map_sha256", "chunk_manifest_sha256", "normalized_candidate_file_sha256", "item_inventory_file_sha256", "locator_packet_set_sha256"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_lock_sha256": {"$ref": "#/$defs/sha256"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "page_map_sha256": {"$ref": "#/$defs/sha256"},
        "chunk_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "normalized_candidate_file_sha256": {"$ref": "#/$defs/sha256"},
        "item_inventory_file_sha256": {"$ref": "#/$defs/sha256"},
        "locator_packet_set_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "selectedWorker": {
      "type": "object",
      "required": ["pull_request", "pull_request_url", "chunk_id", "receipt_sha256", "recovery_sha256", "public_report_sha256", "private_artifact_sha256", "open_evidence_sha256", "merge_evidence_sha256", "head_commit", "merge_commit", "canonical_path"],
      "properties": {
        "pull_request": {"type": "integer", "minimum": 1},
        "pull_request_url": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[1-9][0-9]*$"},
        "chunk_id": {"type": "string", "pattern": "^CHUNK-[A-Za-z0-9._-]+$"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "recovery_sha256": {"$ref": "#/$defs/sha256"},
        "public_report_sha256": {"$ref": "#/$defs/sha256"},
        "private_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "open_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "merge_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "head_commit": {"$ref": "#/$defs/commit"},
        "merge_commit": {"$ref": "#/$defs/commit"},
        "canonical_path": {"type": "string", "pattern": "^candidate/[^/]+/locator-audits/locator-audit\\.CHUNK-[A-Za-z0-9._-]+\\.v[1-9][0-9]*\\.json$"}
      },
      "additionalProperties": false
    },
    "transactionOrder": {
      "type": "array",
      "prefixItems": [
        {"const": "validate_selected_batch"},
        {"const": "verify_merged_pull_requests"},
        {"const": "materialize_private_artifacts"},
        {"const": "write_integration_provenance"},
        {"const": "update_manifest"},
        {"const": "update_state_last"},
        {"const": "validate_canonical_evaluation"},
        {"const": "create_cumulative_checkpoint"},
        {"const": "commit_shared_control_once"}
      ],
      "minItems": 9,
      "maxItems": 9
    }
  },
  "additionalProperties": false
}
