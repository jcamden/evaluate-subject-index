{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact-manifest.schema.json",
  "title": "Subject index evaluation artifact manifest",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "created_at", "updated_at", "artifacts"],
  "properties": {
    "schema_version": {"const": "subject-index-artifact-manifest-v1"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "stage",
          "artifact_type",
          "path",
          "sha256",
          "media_type",
          "visibility",
          "retention",
          "frozen",
          "recorded_at"
        ],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^ART-[A-F0-9]{12}$"},
          "stage": {"type": "string", "minLength": 1},
          "artifact_type": {"type": "string", "minLength": 1},
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          },
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "media_type": {"type": "string", "minLength": 1},
          "visibility": {"enum": ["public", "private", "restricted"]},
          "retention": {"enum": ["required", "cache"]},
          "frozen": {"type": "boolean"},
          "recorded_at": {"type": "string"},
          "supersedes": {"type": ["string", "null"]},
          "input_sha256": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "active_for_scoring_identity": {"type": "boolean"},
          "scoring_identity": {"type": ["object", "null"]},
          "stage_completion_eligible": {"type": "boolean"},
          "invalidated_at": {"type": "string"},
          "invalidation_reason": {"const": "score_calculation_profile_changed"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
