{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parallel-source-discovery-receipt.schema.json",
  "title": "Parallel source-discovery worker receipt",
  "type": "object",
  "required": [
    "schema_version",
    "evaluation_id",
    "created_at",
    "status",
    "chunk_id",
    "project",
    "source_sha256",
    "validation",
    "publication_scope"
  ],
  "properties": {
    "schema_version": {"const": "parallel-source-discovery-receipt-v1"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "status": {"const": "ready_for_pull_request"},
    "chunk_id": {"type": "string", "pattern": "^CHUNK-[0-9]+$"},
    "project": {
      "type": "object",
      "required": ["repository", "base_commit", "base_branch", "worker_branch", "mergeable_path"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "base_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "base_branch": {"type": "string", "minLength": 1},
        "worker_branch": {"type": "string", "minLength": 1},
        "mergeable_path": {
          "type": "string",
          "pattern": "^source/source-subject-chunk\\.CHUNK-[0-9]+\\.json$"
        }
      },
      "additionalProperties": true
    },
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "validation": {
      "type": "object",
      "required": [
        "ok",
        "chunk_id",
        "artifact_sha256",
        "candidate_blindness",
        "expected_owned_pages",
        "reviewed_owned_pages",
        "indexable_source_words",
        "subject_count",
        "priority_counts",
        "evidence_count"
      ],
      "properties": {
        "ok": {"const": true},
        "chunk_id": {"type": "string"},
        "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "candidate_blindness": {"const": "preserved"},
        "expected_owned_pages": {"type": "integer", "minimum": 0},
        "reviewed_owned_pages": {"type": "integer", "minimum": 0},
        "indexable_source_words": {"type": "integer", "minimum": 0},
        "subject_count": {"type": "integer", "minimum": 0},
        "priority_counts": {"type": "object"},
        "evidence_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "publication_scope": {
      "type": "object",
      "required": ["allowed_paths", "forbidden_content"],
      "properties": {
        "allowed_paths": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
        "forbidden_content": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
