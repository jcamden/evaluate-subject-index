{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v7-migration-input.schema.json",
  "title": "Hash-bound V6-to-V7 score-only migration input",
  "type": "object",
  "required": ["schema_version", "methodology", "canonical", "counterfactuals"],
  "properties": {
    "schema_version": {"const": "subject-index-v6-to-v7-migration-input-v1"},
    "methodology": {
      "type": "object",
      "required": ["repository", "base_commit", "implementation_commit"],
      "properties": {
        "repository": {"const": "https://github.com/jcamden/evaluate-subject-index"},
        "base_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "implementation_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      },
      "additionalProperties": false
    },
    "canonical": {
      "type": "object",
      "required": ["dimension_calculation_input", "normalized_candidate", "item_inventory", "v6_calculation", "v6_evaluation_result", "v6_item_assessments", "v6_web_report", "v6_projection_metadata"],
      "properties": {
        "dimension_calculation_input": {"$ref": "#/$defs/artifact"},
        "normalized_candidate": {"$ref": "#/$defs/artifact"},
        "item_inventory": {"$ref": "#/$defs/artifact"},
        "v6_calculation": {"$ref": "#/$defs/artifact"},
        "v6_evaluation_result": {"$ref": "#/$defs/artifact"},
        "v6_item_assessments": {"$ref": "#/$defs/artifact"},
        "v6_web_report": {"$ref": "#/$defs/artifact"},
        "v6_projection_metadata": {"$ref": "#/$defs/artifact"},
        "supplemental_architecture_review": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false
    },
    "counterfactuals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["view_id", "dimension_calculation_input", "normalized_candidate", "item_inventory", "v6_calculation"],
        "properties": {
          "view_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "dimension_calculation_input": {"$ref": "#/$defs/artifact"},
          "normalized_candidate": {"$ref": "#/$defs/artifact"},
          "item_inventory": {"$ref": "#/$defs/artifact"},
          "v6_calculation": {"$ref": "#/$defs/artifact"},
          "supplemental_architecture_review": {"$ref": "#/$defs/artifact"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
