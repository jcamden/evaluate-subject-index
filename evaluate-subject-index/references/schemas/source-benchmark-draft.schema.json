{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-benchmark-draft.schema.json",
  "title": "Unfrozen source subject benchmark draft",
  "type": "object",
  "required": ["schema_version", "benchmark_id", "version", "evaluation_id", "source_sha256", "policy_sha256", "page_map_sha256", "chunk_manifest_sha256", "candidate_blindness", "subjects", "relationships", "reader_tasks", "synthesis"],
  "properties": {
    "schema_version": {"const": "source-subject-benchmark-draft-v1"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "evaluation_id": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "page_map_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "chunk_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_blindness": {"enum": ["preserved", "compromised", "not_claimed"]},
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject_id", "label", "priority", "meaning", "stance", "acceptable_access", "evidence"],
        "properties": {
          "subject_id": {"type": "string", "pattern": "^SUBJ-"},
          "label": {"type": "string", "minLength": 1},
          "priority": {"enum": ["essential", "major", "optional", "exclude_by_default"]},
          "meaning": {"type": "string", "minLength": 1},
          "stance": {"type": "string", "minLength": 1},
          "acceptable_access": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "chapter_provenance": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relationship_id", "source_subject_id", "resolution_status"],
        "properties": {
          "relationship_id": {"type": "string", "pattern": "^REL-"},
          "source_subject_id": {"type": "string", "pattern": "^SUBJ-"},
          "target_subject_id": {"type": "string", "pattern": "^SUBJ-"},
          "resolution_status": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "reader_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "question", "subject_ids"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^TASK-"},
          "question": {"type": "string", "minLength": 1},
          "subject_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SUBJ-"}},
          "source_task_ids": {"type": "array", "items": {"type": "string"}},
          "fallback_generated": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "synthesis": {
      "type": "object",
      "required": ["whole_source_pass_complete", "all_chunk_artifacts_reconciled", "candidate_unseen"],
      "properties": {
        "whole_source_pass_complete": {"const": true},
        "all_chunk_artifacts_reconciled": {"const": true},
        "candidate_unseen": {"const": true}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
