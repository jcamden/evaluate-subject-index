{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-preparation-bundle-metadata.schema.json",
  "title": "Candidate-preparation private recovery bundle metadata",
  "type": "object",
  "required": ["schema_version", "bundle_metadata_sha256", "candidate_id", "candidate_sha256", "source_sha256", "source_edition", "page_map_sha256", "chunk_manifest_sha256", "policy_sha256", "rubric_version", "audit_mode", "checkpoint_ref", "artifacts", "excluded"],
  "properties": {
    "schema_version": {"const": "candidate-preparation-recovery-bundle-v1"},
    "bundle_metadata_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "source_edition": {"type": "string", "minLength": 1},
    "page_map_sha256": {"$ref": "#/$defs/sha256"},
    "chunk_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "rubric_version": {"const": "subject-index-rubric-v4"},
    "audit_mode": {"enum": ["full", "pilot"]},
    "checkpoint_ref": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["artifact", "path", "sha256", "byte_length"],
        "properties": {
          "artifact": {"enum": ["candidate_ref", "layout_profile", "layout_extraction", "candidate_index", "item_inventory", "normalization_exceptions", "normalization_report", "normalization_qa"]},
          "path": {"$ref": "#/$defs/relativePath"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "byte_length": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "excluded": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["candidate PDF bytes", "source PDF bytes", "benchmark content", "secrets"]},
      "allOf": [
        {"contains": {"const": "candidate PDF bytes"}},
        {"contains": {"const": "source PDF bytes"}},
        {"contains": {"const": "benchmark content"}},
        {"contains": {"const": "secrets"}}
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"}
  },
  "additionalProperties": false
}
