{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v7-locator-fit-rationale-ledger.schema.json",
  "title": "Public-safe locator-fit rationale ledger",
  "type": "object",
  "required": ["schema_version", "ledger_id", "evaluation_id", "candidate_identity", "audit_mode", "records", "ledger_sha256"],
  "properties": {
    "schema_version": {"const": "subject-index-v7-locator-fit-rationale-ledger-v1"},
    "ledger_id": {"type": "string", "pattern": "^FITRATLED-[A-F0-9]{12}$"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "candidate_identity": {"type": "object", "required": ["candidate_id", "candidate_sha256"], "properties": {"candidate_id": {"type": "string", "minLength": 1}, "candidate_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false},
    "audit_mode": {"enum": ["full", "pilot"]},
    "records": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["rationale_id", "locator_id", "path_id", "public_safe_rationale", "evidence_ids", "rationale_sha256"], "properties": {"rationale_id": {"type": "string", "pattern": "^FITRAT-[A-F0-9]{12}$"}, "locator_id": {"type": "string", "pattern": "^LOC-"}, "path_id": {"type": "string", "pattern": "^PATH-"}, "public_safe_rationale": {"type": "string", "minLength": 1, "maxLength": 2000}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "rationale_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}},
    "ledger_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "additionalProperties": false
}
