{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chunk-manifest.schema.json",
  "title": "Validated document-page chunk manifest",
  "allOf": [
    {"$ref": "chunk-manifest-input.schema.json"},
    {
      "type": "object",
      "required": ["page_map_sha256", "validation", "chunk_manifest_sha256"],
      "properties": {
        "page_map_sha256": {"type": "string"},
        "validation": {
          "type": "object",
          "required": ["owned_pages_unique", "scope_coverage_complete"],
          "properties": {
            "owned_pages_unique": {"const": true},
            "scope_coverage_complete": {"type": "boolean"}
          },
          "additionalProperties": true
        },
        "chunk_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  ]
}
