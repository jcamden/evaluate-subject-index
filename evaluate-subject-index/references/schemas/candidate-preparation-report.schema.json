{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-preparation-report.schema.json",
  "title": "Strict public candidate-preparation aggregate report",
  "type": "object",
  "required": ["schema_version", "candidate_id", "candidate_sha256", "source_sha256", "page_map_sha256", "adapter_identity", "aggregate_counts", "exception_count", "qa", "normalization", "benchmark_lock_status", "private_artifacts_published", "status"],
  "properties": {
    "schema_version": {"const": "candidate-preparation-public-report-v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "page_map_sha256": {"$ref": "#/$defs/sha256"},
    "adapter_identity": {"$ref": "#/$defs/adapter"},
    "aggregate_counts": {
      "type": "object",
      "required": ["record_count", "main_heading_count", "subheading_count", "complete_heading_path_count", "displayed_locator_count", "expanded_locator_assignment_count", "cross_reference_count", "unresolved_locator_count", "candidate_pdf_pages", "reading_order_regions", "extracted_lines", "normalization_exceptions", "editorial_corrections_applied", "benchmark_content_used"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "record_count": {"type": "integer", "minimum": 0},
        "main_heading_count": {"type": "integer", "minimum": 0},
        "subheading_count": {"type": "integer", "minimum": 0},
        "complete_heading_path_count": {"type": "integer", "minimum": 0},
        "displayed_locator_count": {"type": "integer", "minimum": 0},
        "expanded_locator_assignment_count": {"type": "integer", "minimum": 0},
        "cross_reference_count": {"type": "integer", "minimum": 0},
        "unresolved_locator_count": {"type": "integer", "minimum": 0},
        "candidate_pdf_pages": {"type": "integer", "minimum": 0},
        "reading_order_regions": {"type": "integer", "minimum": 0},
        "extracted_lines": {"type": "integer", "minimum": 0},
        "normalization_exceptions": {"type": "integer", "minimum": 0},
        "editorial_corrections_applied": {"const": false},
        "benchmark_content_used": {"const": false}
      },
      "additionalProperties": false
    },
    "exception_count": {"type": "integer", "minimum": 0},
    "qa": {
      "type": "object",
      "required": ["mode", "exact_set_gate_complete", "candidate_reproduction_confirmed", "editorial_quality_judgments_performed"],
      "properties": {
        "mode": {"const": "full"},
        "exact_set_gate_complete": {"const": true},
        "candidate_reproduction_confirmed": {"const": true},
        "editorial_quality_judgments_performed": {"const": false}
      },
      "additionalProperties": false
    },
    "normalization": {
      "type": "object",
      "required": ["editorial_corrections_applied", "benchmark_content_used"],
      "properties": {
        "editorial_corrections_applied": {"const": false},
        "benchmark_content_used": {"const": false}
      },
      "additionalProperties": false
    },
    "benchmark_lock_status": {"const": "pending_final_benchmark"},
    "private_artifacts_published": {"const": false},
    "status": {"const": "ready_for_private_receipt"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "adapter": {
      "type": "object",
      "required": ["requested_id", "id", "version", "selection_reason"],
      "properties": {
        "requested_id": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "selection_reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
