{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "web-report.schema.json",
  "title": "Display-ready subject index report",
  "type": "object",
  "required": ["schema_version", "report_id", "headline", "summary", "grade", "scorecard", "key_metrics", "density", "gate_status", "strengths", "defects", "examples", "item_grade_index", "methodology", "comparability", "disclosures", "limitations", "evidence_index"],
  "properties": {
    "schema_version": {"const": "subject-index-web-report-v3"},
    "report_id": {"type": "string"},
    "headline": {"type": "string"},
    "summary": {"type": "string"},
    "grade": {
      "type": "object",
      "required": ["score", "maximum", "label"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "maximum": {"const": 100},
        "label": {"type": "string"}
      }
    },
    "scorecard": {"type": "array", "items": {"type": "object"}},
    "key_metrics": {"type": "array", "items": {"type": "object"}},
    "density": {
      "type": "object",
      "required": ["headline", "calibration_disclosure", "measurement_level", "targets", "chapter_measurements", "fit_rating", "points_contributed", "maximum_points"],
      "properties": {
        "headline": {"type": "string"},
        "calibration_disclosure": {"type": "string"},
        "measurement_level": {"const": "chapter_or_approved_intellectual_unit"},
        "targets": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}},
        "chapter_measurements": {"type": "array", "items": {"type": "object"}},
        "fit_rating": {"type": "number", "minimum": 0, "maximum": 5},
        "points_contributed": {"type": "number", "minimum": 0, "maximum": 5},
        "maximum_points": {"const": 5}
      },
      "additionalProperties": true
    },
    "gate_status": {"type": "object"},
    "strengths": {"type": "array", "items": {"type": "object"}},
    "defects": {"type": "array", "items": {"type": "object"}},
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["example_id", "category", "title", "source_paraphrase", "candidate_display", "judgment", "evidence_ids"],
        "additionalProperties": true
      }
    },
    "item_grade_index": {
      "type": "object",
      "required": ["artifact_path", "sha256", "grading_policy", "summary", "color_legend", "interaction"],
      "properties": {
        "artifact_path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "grading_policy": {"const": "subject-index-item-grading-v1"},
        "summary": {"type": "object"},
        "color_legend": {"type": "array", "items": {"type": "object"}},
        "interaction": {
          "type": "object",
          "required": ["color_source", "popover_source", "not_measured_behavior"],
          "properties": {
            "color_source": {"const": "grade.color_token"},
            "popover_source": {"const": "popover"},
            "not_measured_behavior": {"const": "neutral_not_failure"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "methodology": {"type": "object"},
    "comparability": {
      "type": "object",
      "required": ["comparison_key", "status"],
      "properties": {
        "comparison_key": {"type": "object"},
        "status": {"enum": ["standalone", "directly_comparable", "not_directly_comparable"]}
      }
    },
    "disclosures": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "evidence_index": {"type": "object"}
  },
  "additionalProperties": true
}
