{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-policy.schema.json",
  "title": "Subject index evaluation policy",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "policy_profile",
    "source_scope",
    "audience",
    "audit_design",
    "content_policies",
    "stage_application",
    "density_profile",
    "critical_gates",
    "rubric",
    "deviations",
    "freeze",
    "policy_sha256"
  ],
  "properties": {
    "schema_version": {"const": "subject-index-evaluation-policy-v2"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_profile": {
      "type": "object",
      "required": ["id", "standard_policy_sha256"],
      "properties": {
        "id": {"const": "subject-index-standard-policy-v1"},
        "standard_policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    },
    "source_scope": {
      "type": "object",
      "required": [
        "source_sha256",
        "document_page_span",
        "page_map_sha256",
        "chunk_manifest_sha256",
        "included",
        "excluded",
        "availability",
        "mixed_page_rule",
        "word_count_basis"
      ],
      "properties": {
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "document_page_span": {
          "type": "array",
          "prefixItems": [{"type": "integer"}, {"type": "integer"}],
          "minItems": 2,
          "maxItems": 2
        },
        "page_map_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "chunk_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "included": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "excluded": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "availability": {"type": "object"},
        "mixed_page_rule": {"type": "string"},
        "word_count_basis": {"const": "indexable source words only"}
      },
      "additionalProperties": true
    },
    "audience": {
      "type": "object",
      "required": ["label", "basis", "confidence", "rationale"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "basis": {"enum": ["inferred", "user_supplied"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "audit_design": {
      "type": "object",
      "required": ["mode", "candidate_blindness", "uncertainty_policy", "uninspectable_locator_rate_tolerance"],
      "properties": {
        "mode": {"enum": ["full", "pilot"]},
        "candidate_blindness": {"enum": ["required", "preferred", "not_claimed"]},
        "uncertainty_policy": {"type": "string", "minLength": 1},
        "uninspectable_locator_rate_tolerance": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "content_policies": {
      "type": "object",
      "required": [
        "scope_compliance",
        "substantive_coverage",
        "editorial_selectivity",
        "conceptual_stance_fidelity",
        "heading_access_architecture",
        "locator_quality",
        "compound_heading_scope",
        "cross_references",
        "whole_index_coherence",
        "mechanical_validity"
      ],
      "additionalProperties": {"type": "object"}
    },
    "stage_application": {"type": "object", "minProperties": 6},
    "density_profile": {
      "type": "object",
      "required": ["status", "measurement_level", "aggregation", "metrics", "rationale", "maximum_score_contribution"],
      "properties": {
        "status": {"const": "scored"},
        "measurement_level": {"const": "chapter_or_approved_intellectual_unit"},
        "aggregation": {"const": "indexable_source_word_weighted_mean"},
        "rationale": {"type": "string"},
        "maximum_score_contribution": {"const": 5},
        "metrics": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "metric_id",
              "unit",
              "scored",
              "weight",
              "target",
              "ideal_min",
              "ideal_max",
              "acceptable_min",
              "acceptable_max",
              "provenance"
            ],
            "properties": {
              "metric_id": {
                "enum": [
                  "locator_bearing_heading_paths_per_1000_source_words",
                  "locator_occurrences_per_1000_source_words"
                ]
              },
              "unit": {"type": "string"},
              "scored": {"const": true},
              "weight": {"const": 0.5},
              "target": {"type": "number"},
              "ideal_min": {"type": "number"},
              "ideal_max": {"type": "number"},
              "acceptable_min": {"type": "number"},
              "acceptable_max": {"type": "number"},
              "provenance": {"const": "subject-index-standard-policy-v1"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "critical_gates": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "required": ["gate_id", "description", "standard"],
        "properties": {
          "gate_id": {"type": "string", "pattern": "^GATE-"},
          "description": {"type": "string"},
          "standard": {"const": true}
        }
      }
    },
    "rubric": {
      "type": "object",
      "required": ["version", "maximum_points"],
      "properties": {
        "version": {"const": "subject-index-rubric-v4"},
        "maximum_points": {"const": 100}
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "replacement", "rationale", "provenance"],
        "additionalProperties": true
      }
    },
    "freeze": {
      "type": "object",
      "required": ["frozen_at", "candidate_seen"],
      "properties": {
        "frozen_at": {"type": "string"},
        "candidate_seen": {"const": false}
      }
    },
    "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
