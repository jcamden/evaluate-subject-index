{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v5-migration-supplement.schema.json",
  "title": "Hash-bound V5 provenance supplement for historical audit ledgers",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "audit_mode", "structure_audit_sha256", "historical_locator_audit_set_sha256", "historical_missing_access_audit_set_sha256", "locator_audit_set_sha256", "missing_access_audit_set_sha256", "audit_set_reconciliation_basis", "scoring_context"],
  "properties": {
    "schema_version": {"const": "subject-index-v5-migration-supplement-v1"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "audit_mode": {"enum": ["full", "pilot"]},
    "structure_audit_sha256": {"$ref": "#/$defs/sha256"},
    "historical_locator_audit_set_sha256": {"$ref": "#/$defs/sha256"},
    "historical_missing_access_audit_set_sha256": {"$ref": "#/$defs/sha256"},
    "locator_audit_set_sha256": {"$ref": "#/$defs/sha256"},
    "missing_access_audit_set_sha256": {"$ref": "#/$defs/sha256"},
    "audit_set_reconciliation_basis": {"const": "same_frozen_files_rehashed_with_subject_index_canonical_audit_set_v1"},
    "scoring_context": {"$ref": "#/$defs/scoringContext"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decimalRate": {"type": "string", "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"},
    "uniqueStrings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "candidateAttempt": {
      "type": "object",
      "required": ["status", "evidence_ids"],
      "properties": {
        "status": {"enum": ["meaningful_attempt", "empty", "structurally_incomplete", "unparseable"]},
        "evidence_ids": {"$ref": "#/$defs/uniqueStrings"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["empty", "structurally_incomplete", "unparseable"]}}}, "then": {"properties": {"evidence_ids": {"minItems": 1}}}}
      ],
      "additionalProperties": false
    },
    "crossReferenceApplicability": {
      "type": "object",
      "required": ["status", "basis_code", "delivered_reference_count", "warranted_reference_obligation_count", "warranted_reference_obligation_ids", "reference_defect_ids"],
      "properties": {
        "status": {"enum": ["applicable", "inapplicable"]},
        "basis_code": {"enum": ["delivered_references", "warranted_reference_obligation", "reference_defect", "no_delivered_references_no_obligation_or_defect"]},
        "delivered_reference_count": {"type": "integer", "minimum": 0},
        "warranted_reference_obligation_count": {"type": "integer", "minimum": 0},
        "warranted_reference_obligation_ids": {
          "$ref": "#/$defs/uniqueStrings",
          "description": "Frozen IDs for undelivered subject, task, treatment, node, or GLOBAL-STRUCTURE obligations; never delivered XREF, locator, or path IDs.",
          "items": {"type": "string", "pattern": "^(?:(?:SUBJ|TASK|TREAT|NODE)-.+|GLOBAL-STRUCTURE)$"}
        },
        "reference_defect_ids": {
          "$ref": "#/$defs/uniqueStrings",
          "description": "IDs of structured findability-navigation XRF defects only."
        }
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "inapplicable"}}}, "then": {"properties": {"basis_code": {"const": "no_delivered_references_no_obligation_or_defect"}, "delivered_reference_count": {"const": 0}, "warranted_reference_obligation_count": {"const": 0}, "warranted_reference_obligation_ids": {"maxItems": 0}, "reference_defect_ids": {"maxItems": 0}}}},
        {"if": {"properties": {"basis_code": {"const": "delivered_references"}}}, "then": {"properties": {"delivered_reference_count": {"minimum": 1}}}},
        {"if": {"properties": {"basis_code": {"const": "warranted_reference_obligation"}}}, "then": {"properties": {"warranted_reference_obligation_count": {"minimum": 1}, "warranted_reference_obligation_ids": {"minItems": 1}}}},
        {"if": {"properties": {"basis_code": {"const": "reference_defect"}}}, "then": {"properties": {"reference_defect_ids": {"minItems": 1}}}}
      ],
      "additionalProperties": false
    },
    "optionalSubject": {
      "type": "object",
      "required": ["subject_id", "scored", "benchmark_evidence_ids"],
      "properties": {
        "subject_id": {"type": "string", "pattern": "^SUBJ-"},
        "scored": {"type": "boolean"},
        "benchmark_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "nodeComponentApplicability": {
      "type": "object",
      "required": ["node_id", "component_id", "basis_code", "evidence_ids"],
      "properties": {
        "node_id": {"type": "string", "pattern": "^NODE-"},
        "component_id": {"enum": ["conceptual_stance_fidelity", "heading_access_architecture", "mechanics_consistency"]},
        "basis_code": {"const": "benchmark_genuinely_inapplicable"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "defect": {
      "type": "object",
      "required": ["defect_id", "code", "dimension_owner", "severity", "severity_basis", "retrieval_consequence", "defect_kind", "affected_item_ids", "affected_source_sections", "affected_structural_sections", "root_cause_family", "affected_count", "applicable_count", "affected_rate", "source_section_denominator", "source_section_rate", "structural_section_denominator", "structural_section_rate", "high_priority_access_destroyed"],
      "properties": {
        "defect_id": {"type": "string", "pattern": "^DEFECT-"},
        "code": {"enum": ["SCP", "COV", "SEL", "CON", "STA", "LOC_POS", "LOC_NEG", "CMP", "HED", "SUB", "XRF", "DEN", "MEC"]},
        "dimension_owner": {"enum": ["meaningful_coverage", "editorial_selectivity", "conceptual_stance_fidelity", "page_reference_reliability", "findability_navigation", "mechanics_consistency"]},
        "severity": {"enum": ["cosmetic", "minor", "major", "critical"]},
        "severity_basis": {"enum": ["fabrication", "central_reversal", "broken_scope", "systemic_nonuse", "materially_misleading", "blocked_retrieval", "localized_repairable_friction", "no_retrieval_consequence"]},
        "retrieval_consequence": {"enum": ["blocks", "misleads", "slows", "none"]},
        "defect_kind": {"enum": ["generic", "central_omission", "fabricated_locator", "nonexistent_locator", "out_of_scope_locator", "stance_reversal", "misleading_relationship", "substitutive_see", "circular_or_chained_reference", "misleading_access_route", "unsupported_reference", "mechanical_invariant", "representation_corruption", "clutter_pattern", "density_distribution", "scope_failure"]},
        "affected_item_ids": {"$ref": "#/$defs/uniqueStrings", "minItems": 1, "description": "One homogeneous frozen item family; runtime validation resolves every ID and binds its family denominator."},
        "affected_source_sections": {"$ref": "#/$defs/uniqueStrings"},
        "affected_structural_sections": {"$ref": "#/$defs/uniqueStrings"},
        "root_cause_family": {"type": "string", "minLength": 1},
        "affected_count": {"type": "integer", "minimum": 0},
        "applicable_count": {"type": "integer", "minimum": 0, "description": "Must equal the scorer-reconstructed stable-ID denominator for the affected item family; a pilot PATH denominator may use only the validated known-through-known-plus-missing range."},
        "affected_rate": {"$ref": "#/$defs/decimalRate"},
        "source_section_denominator": {"type": "integer", "minimum": 0},
        "source_section_rate": {"$ref": "#/$defs/decimalRate"},
        "structural_section_denominator": {"type": "integer", "minimum": 0},
        "structural_section_rate": {"$ref": "#/$defs/decimalRate"},
        "high_priority_access_destroyed": {"type": "boolean"}
      },
      "anyOf": [
        {"properties": {"affected_source_sections": {"minItems": 1}}},
        {"properties": {"affected_structural_sections": {"minItems": 1}}}
      ],
      "allOf": [
        {"if": {"properties": {"severity": {"const": "critical"}}}, "then": {"properties": {"severity_basis": {"enum": ["fabrication", "central_reversal", "broken_scope", "systemic_nonuse"]}, "retrieval_consequence": {"enum": ["blocks", "misleads"]}}}},
        {"if": {"properties": {"severity": {"const": "major"}}}, "then": {"properties": {"severity_basis": {"enum": ["materially_misleading", "blocked_retrieval"]}, "retrieval_consequence": {"enum": ["blocks", "misleads"]}}}},
        {"if": {"properties": {"severity": {"const": "minor"}}}, "then": {"properties": {"severity_basis": {"const": "localized_repairable_friction"}, "retrieval_consequence": {"const": "slows"}}}},
        {"if": {"properties": {"severity": {"const": "cosmetic"}}}, "then": {"properties": {"severity_basis": {"const": "no_retrieval_consequence"}, "retrieval_consequence": {"const": "none"}}}},
        {"if": {"properties": {"severity_basis": {"const": "fabrication"}}}, "then": {"properties": {"dimension_owner": {"const": "page_reference_reliability"}, "code": {"enum": ["SCP", "LOC_POS"]}, "defect_kind": {"enum": ["fabricated_locator", "nonexistent_locator", "out_of_scope_locator"]}, "retrieval_consequence": {"const": "misleads"}}}},
        {"if": {"properties": {"severity_basis": {"const": "central_reversal"}}}, "then": {"properties": {"dimension_owner": {"const": "conceptual_stance_fidelity"}, "code": {"enum": ["CON", "STA", "CMP"]}, "defect_kind": {"enum": ["stance_reversal", "misleading_relationship"]}, "retrieval_consequence": {"const": "misleads"}}}},
        {"if": {"properties": {"severity_basis": {"const": "broken_scope"}}}, "then": {"properties": {"dimension_owner": {"enum": ["meaningful_coverage", "page_reference_reliability", "findability_navigation"]}, "code": {"enum": ["COV", "SCP", "LOC_POS", "HED", "SUB", "XRF", "CMP"]}, "defect_kind": {"enum": ["central_omission", "out_of_scope_locator", "scope_failure", "substitutive_see", "circular_or_chained_reference", "misleading_access_route"]}}}},
        {"if": {"properties": {"severity_basis": {"const": "systemic_nonuse"}}}, "then": {"properties": {"affected_count": {"minimum": 3}, "retrieval_consequence": {"const": "blocks"}}}},
        {"if": {"properties": {"severity_basis": {"const": "materially_misleading"}}}, "then": {"properties": {"retrieval_consequence": {"const": "misleads"}}}},
        {"if": {"properties": {"severity_basis": {"const": "blocked_retrieval"}}}, "then": {"properties": {"retrieval_consequence": {"const": "blocks"}}}}
      ],
      "additionalProperties": false
    },
    "scoringContext": {
      "type": "object",
      "required": ["candidate_attempt", "cross_reference_applicability", "optional_subject_scoring", "node_component_applicability", "defects"],
      "properties": {
        "candidate_attempt": {"$ref": "#/$defs/candidateAttempt"},
        "cross_reference_applicability": {"$ref": "#/$defs/crossReferenceApplicability"},
        "optional_subject_scoring": {"type": "array", "items": {"$ref": "#/$defs/optionalSubject"}},
        "node_component_applicability": {"type": "array", "items": {"$ref": "#/$defs/nodeComponentApplicability"}},
        "defects": {"type": "array", "items": {"$ref": "#/$defs/defect"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
