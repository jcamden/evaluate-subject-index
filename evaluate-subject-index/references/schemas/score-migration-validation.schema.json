{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "score-migration-validation.schema.json",
  "title": "Post-projection validation receipt for a V4-to-V5 score migration",
  "type": "object",
  "required": ["schema_version", "validation_timestamp", "tool", "methodology", "evaluation_id", "artifacts", "totals", "dimension_comparison", "gate_comparison", "score_views", "validation_sha256"],
  "properties": {
    "schema_version": {"const": "subject-index-score-migration-validation-v1"},
    "validation_timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {"name": {"const": "dimension_score_cli.py"}, "version": {"const": "dimension-score-cli-v5.1.0"}},
      "additionalProperties": false
    },
    "methodology": {
      "type": "object",
      "required": ["repository", "commit_sha"],
      "properties": {
        "repository": {"const": "https://github.com/jcamden/evaluate-subject-index"},
        "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      },
      "additionalProperties": false
    },
    "evaluation_id": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "object",
      "required": ["historical_result", "dimension_calculations", "migration_record", "evaluation_result", "web_report"],
      "properties": {
        "historical_result": {"$ref": "#/$defs/artifact"},
        "dimension_calculations": {
          "allOf": [
            {"$ref": "#/$defs/artifact"},
            {"type": "object", "required": ["canonical_sha256"], "properties": {"canonical_sha256": {"$ref": "#/$defs/sha256"}}}
          ]
        },
        "migration_record": {
          "allOf": [
            {"$ref": "#/$defs/artifact"},
            {"type": "object", "required": ["canonical_sha256"], "properties": {"canonical_sha256": {"$ref": "#/$defs/sha256"}}}
          ]
        },
        "evaluation_result": {"$ref": "#/$defs/artifact"},
        "web_report": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "required": ["previous", "migrated", "delta"],
      "properties": {
        "previous": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "migrated": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "delta": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    },
    "dimension_comparison": {"$ref": "score-migration.schema.json#/$defs/dimensionComparisonArray"},
    "gate_comparison": {
      "type": "object",
      "required": ["historical_outcomes_sha256", "migrated_outcomes_sha256", "historical_outcomes", "migrated_outcomes", "outcomes_equal"],
      "properties": {
        "historical_outcomes_sha256": {"$ref": "#/$defs/sha256"},
        "migrated_outcomes_sha256": {"$ref": "#/$defs/sha256"},
        "historical_outcomes": {"type": "array", "items": {"type": "object"}},
        "migrated_outcomes": {"type": "array", "items": {"type": "object"}},
        "outcomes_equal": {"const": true}
      },
      "additionalProperties": false
    },
    "score_views": {"$ref": "web-report-v4.schema.json#/$defs/scoreViews"},
    "validation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["schema_version", "path", "sha256"],
      "properties": {
        "schema_version": {"type": "string", "minLength": 1},
        "path": {"$ref": "score-migration.schema.json#/$defs/portablePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
