{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-integration-checkpoint.schema.json",
  "title": "Candidate integration private checkpoint metadata",
  "type": "object",
  "required": ["schema_version", "checkpoint_metadata_sha256", "evaluation_id", "candidate_id", "candidate_sha256", "benchmark_lock_sha256", "included_paths", "included_hashes", "excluded"],
  "properties": {
    "schema_version": {"const": "candidate-integration-checkpoint-v1"},
    "checkpoint_metadata_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark_lock_sha256": {"$ref": "#/$defs/sha256"},
    "included_paths": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativePath"},
      "allOf": [
        {"contains": {"const": "evaluation-state.json"}},
        {"contains": {"const": "artifact-manifest.json"}}
      ]
    },
    "included_hashes": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": {"$ref": "#/$defs/relativePath"},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "excluded": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["candidate PDF bytes", "source PDF bytes", "benchmark repository content", "secrets"]},
      "allOf": [
        {"contains": {"const": "candidate PDF bytes"}},
        {"contains": {"const": "source PDF bytes"}},
        {"contains": {"const": "benchmark repository content"}},
        {"contains": {"const": "secrets"}}
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"}
  },
  "additionalProperties": false
}
