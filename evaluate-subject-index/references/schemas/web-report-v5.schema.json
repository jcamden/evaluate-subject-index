{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "web-report-v5.schema.json",
  "title": "Display-ready V6 subject-index report",
  "type": "object",
  "required": ["schema_version", "report_id", "headline", "summary", "grade", "scorecard", "calculation_explainer", "precision_diagnostics", "key_metrics", "density", "gate_status", "strengths", "defects", "examples", "item_grade_index", "migration_comparison", "score_views", "methodology", "comparability", "disclosures", "limitations", "evidence_index"],
  "properties": {
    "schema_version": {"const": "subject-index-web-report-v5"},
    "report_id": {"type": "string"},
    "headline": {"type": "string"},
    "summary": {"type": "string"},
    "grade": {"type": "object", "required": ["score", "maximum", "label"], "properties": {"score": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "maximum": {"const": 100}, "label": {"type": "string"}}, "additionalProperties": true},
    "scorecard": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/scorecardItem"},
      "allOf": [
        {"contains": {"properties": {"dimension_id": {"const": "meaningful_coverage"}}, "required": ["dimension_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension_id": {"const": "editorial_selectivity"}}, "required": ["dimension_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension_id": {"const": "conceptual_stance_fidelity"}}, "required": ["dimension_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension_id": {"const": "page_reference_reliability"}}, "required": ["dimension_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension_id": {"const": "findability_navigation"}}, "required": ["dimension_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"dimension_id": {"const": "mechanics_consistency"}}, "required": ["dimension_id"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "calculation_explainer": {
      "type": "object",
      "required": ["artifact_path", "sha256", "rubric_version", "calculation_profile", "item_grades_used", "gates_used"],
      "properties": {
        "artifact_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "rubric_version": {"const": "subject-index-rubric-v6"},
        "calculation_profile": {"const": "subject-index-dimension-calculation-v2"},
        "item_grades_used": {"const": false},
        "gates_used": {"const": false}
      },
      "additionalProperties": false
    },
    "precision_diagnostics": {"$ref": "evaluation-result-v7.schema.json#/$defs/precisionDiagnostics"},
    "key_metrics": {"type": "array", "items": {"type": "object"}},
    "density": {"type": "object"},
    "gate_status": {
      "type": "object",
      "required": ["critical_gates", "outcomes_sha256", "used_in_score_arithmetic"],
      "properties": {"critical_gates": {"type": "array", "items": {"type": "object"}}, "outcomes_sha256": {"$ref": "#/$defs/sha256"}, "used_in_score_arithmetic": {"const": false}},
      "additionalProperties": false
    },
    "strengths": {"type": "array", "items": {"type": "object"}},
    "defects": {"type": "array", "items": {"type": "object"}},
    "examples": {"type": "array", "items": {"type": "object"}},
    "item_grade_index": {
      "type": "object",
      "required": ["schema_version", "artifact_path", "sha256", "grading_policy", "summary", "color_legend", "interaction"],
      "properties": {
        "schema_version": {"const": "subject-index-item-assessments-v3"},
        "artifact_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "grading_policy": {"const": "subject-index-item-grading-v2"},
        "summary": {"type": "object"},
        "color_legend": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object"}},
        "interaction": {"type": "object", "required": ["color_source", "popover_source", "not_measured_behavior"], "properties": {"color_source": {"const": "grade.color_token"}, "popover_source": {"const": "popover"}, "not_measured_behavior": {"const": "neutral_not_failure"}}, "additionalProperties": false}
      },
      "additionalProperties": false
    },
    "migration_comparison": {"$ref": "#/$defs/migrationComparison"},
    "score_views": {"$ref": "#/$defs/scoreViews"},
    "methodology": {"type": "object"},
    "comparability": {"type": "object"},
    "disclosures": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "evidence_index": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifactReference": {
      "type": "object",
      "required": ["role", "schema_version", "artifact_path", "sha256"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "artifact_path": {"$ref": "score-migration.schema.json#/$defs/portablePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "scorecardItem": {
      "type": "object",
      "required": ["dimension_id", "label", "rating", "unrounded_rating", "weight", "awarded_points", "status", "formula_id", "input_artifacts", "denominators", "raw_status_counts", "credit_mappings", "components", "base_rating", "pre_cap_rating", "post_cap_rating", "cap_evaluations", "applied_cap", "rounding", "missing_data_bounds"],
      "properties": {
        "dimension_id": {"enum": ["meaningful_coverage", "editorial_selectivity", "conceptual_stance_fidelity", "page_reference_reliability", "findability_navigation", "mechanics_consistency"]},
        "label": {"type": "string"},
        "rating": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
        "unrounded_rating": {"$ref": "dimension-calculations.schema.json#/$defs/decimal"},
        "weight": {"enum": [5, 15, 20, 25]},
        "awarded_points": {"type": ["number", "null"], "minimum": 0},
        "status": {"enum": ["scored", "not_scored_incomplete_full_audit", "not_scored_insufficient_evidence"]},
        "formula_id": {"type": "string", "pattern": "^subject-index-dimension-calculation-v2:"},
        "input_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "dimension-calculations.schema.json#/$defs/inputArtifact"}},
        "denominators": {"type": "object"},
        "raw_status_counts": {"type": "object"},
        "credit_mappings": {"type": "object"},
        "components": {"type": "array", "minItems": 1, "items": {"$ref": "dimension-calculations.schema.json#/$defs/component"}},
        "base_rating": {"$ref": "dimension-calculations.schema.json#/$defs/decimal"},
        "pre_cap_rating": {"$ref": "dimension-calculations.schema.json#/$defs/decimal"},
        "post_cap_rating": {"$ref": "dimension-calculations.schema.json#/$defs/decimal"},
        "cap_evaluations": {"type": "array", "items": {"$ref": "dimension-calculations.schema.json#/$defs/cap"}},
        "applied_cap": {"$ref": "dimension-calculations.schema.json#/$defs/appliedCap"},
        "rounding": {"type": "object"},
        "missing_data_bounds": {"type": "object"},
        "reliability_provenance": {"$ref": "dimension-calculations-v2.schema.json#/$defs/reliabilityProvenance"}
      },
      "allOf": [{"if": {"properties": {"dimension_id": {"const": "page_reference_reliability"}}, "required": ["dimension_id"]}, "then": {"required": ["reliability_provenance"]}, "else": {"not": {"required": ["reliability_provenance"]}}}],
      "additionalProperties": false
    },
    "calculationReference": {
      "type": "object",
      "required": ["schema_version", "artifact_path", "sha256", "calculation_sha256", "rubric_version", "calculation_profile"],
      "properties": {"schema_version": {"const": "subject-index-dimension-calculations-v2"}, "artifact_path": {"$ref": "score-migration.schema.json#/$defs/portablePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "calculation_sha256": {"$ref": "#/$defs/sha256"}, "rubric_version": {"const": "subject-index-rubric-v6"}, "calculation_profile": {"const": "subject-index-dimension-calculation-v2"}},
      "additionalProperties": false
    },
    "scoreView": {
      "type": "object",
      "required": ["view_id", "label", "view_kind", "score", "maximum", "calculation", "causal_attribution", "provenance_artifacts"],
      "properties": {
        "view_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "view_kind": {"enum": ["observed", "counterfactual"]},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "maximum": {"const": 100},
        "calculation": {"$ref": "#/$defs/calculationReference"},
        "causal_attribution": {"enum": ["primary_observed_result", "separate_evidentiary_correction_not_methodology_effect"]},
        "provenance_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifactReference"}, "uniqueItems": true}
      },
      "allOf": [
        {
          "if": {"properties": {"view_kind": {"const": "observed"}}, "required": ["view_kind"]},
          "then": {"properties": {"causal_attribution": {"const": "primary_observed_result"}, "provenance_artifacts": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"view_kind": {"const": "counterfactual"}}, "required": ["view_kind"]},
          "then": {"properties": {"causal_attribution": {"const": "separate_evidentiary_correction_not_methodology_effect"}, "provenance_artifacts": {"minItems": 1}}}
        }
      ],
      "additionalProperties": false
    },
    "scoreViews": {
      "type": "object",
      "required": ["primary_view_id", "adjustment_status", "views"],
      "properties": {
        "primary_view_id": {"const": "canonical_as_delivered"},
        "adjustment_status": {"enum": ["none", "separate_evidentiary_correction"]},
        "views": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scoreView"}, "uniqueItems": true}
      },
      "allOf": [
        {
          "if": {"properties": {"adjustment_status": {"const": "none"}}, "required": ["adjustment_status"]},
          "then": {"properties": {"views": {"not": {"contains": {"properties": {"view_kind": {"const": "counterfactual"}}, "required": ["view_kind"]}}}}}
        },
        {
          "if": {"properties": {"adjustment_status": {"const": "separate_evidentiary_correction"}}, "required": ["adjustment_status"]},
          "then": {"properties": {"views": {"contains": {"properties": {"view_kind": {"const": "counterfactual"}}, "required": ["view_kind"]}, "minContains": 1}}}
        }
      ],
      "additionalProperties": false
    },
    "migrationComparison": {
      "oneOf": [
        {"type": "object", "required": ["status"], "properties": {"status": {"const": "not_applicable"}}, "additionalProperties": false},
        {"type": "object", "required": ["status", "migration_record", "methodology_commit", "previous_total", "migrated_total", "dimension_comparison", "precision_comparison", "gate_comparison"], "properties": {"status": {"const": "v5_to_v6"}, "migration_record": {"type": "object", "required": ["schema_version", "artifact_path", "sha256", "migration_sha256"], "properties": {"schema_version": {"const": "subject-index-score-migration-v5-to-v6-v1"}, "artifact_path": {"$ref": "score-migration.schema.json#/$defs/portablePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "migration_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}, "methodology_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "previous_total": {"type": ["number", "null"]}, "migrated_total": {"type": ["number", "null"]}, "dimension_comparison": {"type": "array"}, "precision_comparison": {"type": "object"}, "gate_comparison": {"type": "object"}}, "additionalProperties": false}
      ]
    }
  },
  "additionalProperties": false
}
