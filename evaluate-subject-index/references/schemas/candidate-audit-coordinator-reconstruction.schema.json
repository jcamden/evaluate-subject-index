{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-audit-coordinator-reconstruction.schema.json",
  "title": "Private coordinator reconstruction record for a public missing-access audit",
  "type": "object",
  "required": [
    "schema_version", "record_sha256", "mode", "reconstructed_at", "authority",
    "evaluation_id", "candidate_id", "chunk_id", "public_artifact_source",
    "original_worker_handoff", "assurances", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "candidate-audit-coordinator-reconstruction-v1"},
    "record_sha256": {"$ref": "#/$defs/sha256"},
    "mode": {"const": "coordinator_reconstructed_from_public_artifact"},
    "reconstructed_at": {"type": "string", "format": "date-time"},
    "authority": {"const": "coordinator"},
    "evaluation_id": {"$ref": "#/$defs/boundedString"},
    "candidate_id": {"$ref": "#/$defs/boundedString"},
    "chunk_id": {"type": "string", "pattern": "^CHUNK-[A-Za-z0-9._-]+$"},
    "public_artifact_source": {
      "type": "object",
      "required": ["candidate_project", "pull_request", "pull_request_url", "head_commit", "repository_path", "file_sha256", "blob_sha", "open_pr_evidence_sha256"],
      "properties": {
        "candidate_project": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$", "maxLength": 256},
        "pull_request": {"type": "integer", "minimum": 1},
        "pull_request_url": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[1-9][0-9]*$"},
        "head_commit": {"$ref": "#/$defs/commit"},
        "repository_path": {"type": "string", "pattern": "^candidate/missing-access-audits/missing-access-audit\\.CHUNK-[A-Za-z0-9._-]+\\.v1\\.json$"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "blob_sha": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
        "open_pr_evidence_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "original_worker_handoff": {
      "type": "object",
      "required": ["materialization_status", "declared_receipt_sha256", "declared_recovery_sha256"],
      "properties": {
        "materialization_status": {"const": "agent_materialization_unavailable"},
        "declared_receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "declared_recovery_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "assurances": {
      "type": "object",
      "required": ["publication_profile", "public_artifact_is_complete_canonical_audit", "public_artifact_byte_identity_recomputed", "frozen_identities_recomputed", "exact_denominators_recomputed", "public_safety_revalidated", "fresh_github_evidence_required"],
      "properties": {
        "publication_profile": {"const": "public_evaluation_artifacts"},
        "public_artifact_is_complete_canonical_audit": {"const": true},
        "public_artifact_byte_identity_recomputed": {"const": true},
        "frozen_identities_recomputed": {"const": true},
        "exact_denominators_recomputed": {"const": true},
        "public_safety_revalidated": {"const": true},
        "fresh_github_evidence_required": {"const": true}
      },
      "additionalProperties": false
    },
    "limitations": {
      "const": ["Original worker receipt and recovery ZIP bytes were not materialized or validated by the coordinator."]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commit": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"},
    "boundedString": {"type": "string", "minLength": 1, "maxLength": 256}
  },
  "additionalProperties": false
}
