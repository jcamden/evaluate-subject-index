{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v7-architecture-review-supplement.schema.json",
  "title": "Hash-bound supplemental V7 architecture determinations for a frozen V6 migration",
  "type": "object",
  "required": [
    "schema_version",
    "supplement_id",
    "evaluation_id",
    "audit_mode",
    "bindings",
    "review_scope",
    "decisions",
    "provenance",
    "supplement_sha256"
  ],
  "properties": {
    "schema_version": {"const": "subject-index-v7-architecture-review-supplement-v1"},
    "supplement_id": {"type": "string", "pattern": "^ARCHSUP-[A-F0-9]{12}$"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "audit_mode": {"enum": ["full", "pilot"]},
    "bindings": {
      "type": "object",
      "required": [
        "candidate_sha256",
        "v6_dimension_calculation_input_file_sha256",
        "normalized_candidate_file_sha256",
        "item_inventory_file_sha256",
        "historical_structure_audit_file_sha256"
      ],
      "properties": {
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "v6_dimension_calculation_input_file_sha256": {"$ref": "#/$defs/sha256"},
        "normalized_candidate_file_sha256": {"$ref": "#/$defs/sha256"},
        "item_inventory_file_sha256": {"$ref": "#/$defs/sha256"},
        "historical_structure_audit_file_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "review_scope": {
      "type": "object",
      "required": ["rule_id", "path_ids"],
      "properties": {
        "rule_id": {"const": "STRUCT-V7-EXACT-UNRESOLVED-TRIGGER-SET"},
        "path_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^PATH-"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "decisions": {"$ref": "structure-audit-v5.schema.json#/properties/v7_architecture_review_decisions"},
    "provenance": {
      "type": "object",
      "required": [
        "authorization_scope",
        "structured_architecture_evidence_only",
        "source_pages_reopened",
        "locator_support_reopened",
        "missing_access_reopened",
        "unrelated_structure_judgments_reopened",
        "display_prose_used_for_grouping",
        "historical_artifacts_modified"
      ],
      "properties": {
        "authorization_scope": {"const": "supplemental_architecture_review_only"},
        "structured_architecture_evidence_only": {"const": true},
        "source_pages_reopened": {"const": false},
        "locator_support_reopened": {"const": false},
        "missing_access_reopened": {"const": false},
        "unrelated_structure_judgments_reopened": {"const": false},
        "display_prose_used_for_grouping": {"const": false},
        "historical_artifacts_modified": {"const": false}
      },
      "additionalProperties": false
    },
    "supplement_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
