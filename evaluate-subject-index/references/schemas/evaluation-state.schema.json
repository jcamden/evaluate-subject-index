{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-state.schema.json",
  "title": "Subject index evaluation state",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "artifact_manifest_path", "source", "configuration", "stages", "artifacts", "blockers"],
  "properties": {
    "schema_version": {"const": "subject-index-evaluation-state-v4"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "artifact_manifest_path": {"const": "artifact-manifest.json"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["title", "filename", "sha256", "document_page_span"],
      "properties": {
        "title": {"type": "string"},
        "edition": {"type": "string", "minLength": 1},
        "edition_identity": {
          "type": "object",
          "required": ["label", "status"],
          "properties": {
            "label": {"type": "string", "minLength": 1},
            "status": {"enum": ["verified", "not_independently_verified", "conflicting_evidence"]},
            "rationale": {"type": "string"}
          },
          "additionalProperties": true
        },
        "filename": {"type": "string"},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "document_page_span": {
          "type": "array",
          "prefixItems": [{"type": "integer"}, {"type": "integer"}],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": true
    },
    "candidate": {
      "type": ["object", "null"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "schema_version": {"const": "candidate-index-v2"},
        "candidate_ref_path": {"$ref": "#/$defs/relativePath"},
        "layout_profile_path": {"$ref": "#/$defs/relativePath"},
        "normalized_path": {"$ref": "#/$defs/relativePath"},
        "item_inventory_path": {"$ref": "#/$defs/relativePath"},
        "normalization_qa_path": {"$ref": "#/$defs/relativePath"},
        "preparation_receipt_path": {"$ref": "#/$defs/relativePath"},
        "preparation_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "benchmark_lock_path": {"$ref": "#/$defs/relativePath"},
        "benchmark_lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    },
    "configuration": {
      "type": "object",
      "required": ["audit_mode", "index_type", "intended_readership", "output_format", "storage_mode"],
      "properties": {
        "audit_mode": {"enum": ["full", "pilot"]},
        "index_type": {"const": "subject_index"},
        "intended_readership": {"type": "string"},
        "readership_provenance": {
          "type": "object",
          "required": ["basis", "confidence", "rationale"],
          "properties": {
            "basis": {"enum": ["inferred", "user_supplied"]},
            "confidence": {"enum": ["high", "medium", "low"]},
            "rationale": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "output_format": {"const": "json"},
        "storage_mode": {"enum": ["local", "library", "hybrid"]},
        "publication_profile": {
          "enum": ["aggregate_only", "public_evaluation_artifacts"],
          "default": "aggregate_only"
        },
        "policy_profile": {"const": "subject-index-standard-policy-v1"},
        "rubric_version": {"const": "subject-index-rubric-v4"}
      },
      "additionalProperties": true
    },
    "stages": {
      "type": "object",
      "minProperties": 14,
      "additionalProperties": {
        "type": "object",
        "required": ["status", "updated_at", "notes"],
        "properties": {
          "status": {"enum": ["not_started", "in_progress", "completed", "blocked"]},
          "updated_at": {"type": ["string", "null"]},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "stage", "artifact_type", "path", "sha256", "visibility", "retention", "frozen", "recorded_at"],
        "properties": {
          "stage": {"type": "string"},
          "artifact_type": {"type": "string"},
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          },
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "artifact_id": {"type": "string", "pattern": "^ART-[A-F0-9]{12}$"},
          "visibility": {"enum": ["public", "private", "restricted"]},
          "retention": {"enum": ["required", "cache"]},
          "frozen": {"type": "boolean"},
          "recorded_at": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "blockers": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    }
  },
  "additionalProperties": true
}
