{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "score-migration-v6-to-v7-v2.schema.json",
  "title": "Hash-bound V6-to-V7 score-only migration",
  "type": "object",
  "required": ["schema_version", "migration_id", "evaluation_id", "tool", "methodology", "repository_state", "from", "to", "frozen_evidence", "dimension_comparison", "precision_comparison", "gate_preservation", "structure_count_correction", "invariants", "migration_sha256"],
  "properties": {
    "schema_version": {"const": "subject-index-score-migration-v6-to-v7-v2"},
    "migration_id": {"type": "string", "pattern": "^MIG-[A-F0-9]{12}$"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {"name": {"const": "dimension_score_v7_cli.py"}, "version": {"type": "string", "pattern": "^dimension-score-cli-v7\\."}},
      "additionalProperties": false
    },
    "methodology": {
      "type": "object",
      "required": ["repository", "base_commit", "implementation_commit"],
      "properties": {
        "repository": {"const": "https://github.com/jcamden/evaluate-subject-index"},
        "base_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "implementation_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      },
      "additionalProperties": false
    },
    "repository_state": {"$ref": "v7-migration-input.schema.json#/$defs/repositoryState"},
    "from": {
      "type": "object",
      "required": ["rubric_version", "calculation_profile", "calculation", "evaluation_result", "item_assessments", "web_report", "projection_metadata", "total_score", "score_views"],
      "properties": {
        "rubric_version": {"const": "subject-index-rubric-v6"},
        "calculation_profile": {"const": "subject-index-dimension-calculation-v2"},
        "calculation": {"$ref": "#/$defs/historicalArtifact"},
        "evaluation_result": {"$ref": "#/$defs/historicalArtifact"},
        "item_assessments": {"$ref": "#/$defs/historicalArtifact"},
        "web_report": {"$ref": "#/$defs/historicalArtifact"},
        "projection_metadata": {"$ref": "#/$defs/historicalArtifact"},
        "total_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "score_views": {"type": "object"}
      },
      "additionalProperties": false
    },
    "to": {
      "type": "object",
      "required": ["rubric_version", "calculation_profile", "calculation", "item_assessments", "projection_metadata", "structure_locator_review", "total_score", "score_views", "counterfactual_calculations"],
      "properties": {
        "rubric_version": {"const": "subject-index-rubric-v7"},
        "calculation_profile": {"const": "subject-index-dimension-calculation-v3"},
        "calculation": {"$ref": "#/$defs/v7Calculation"},
        "item_assessments": {"$ref": "#/$defs/artifact"},
        "projection_metadata": {"allOf": [{"$ref": "#/$defs/artifact"}, {"required": ["projection_metadata_sha256"], "properties": {"projection_metadata_sha256": {"$ref": "#/$defs/sha256"}}}]},
        "structure_locator_review": {"$ref": "#/$defs/reviewArtifact"},
        "total_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "score_views": {"$ref": "web-report-v7.schema.json#/properties/score_views"},
        "counterfactual_calculations": {"type": "array", "items": {"type": "object", "required": ["view_id", "calculation", "structure_locator_review", "provenance_artifacts"], "properties": {"view_id": {"type": "string"}, "calculation": {"$ref": "#/$defs/v7Calculation"}, "structure_locator_review": {"$ref": "#/$defs/reviewArtifact"}, "provenance_artifacts": {"type": "array", "items": {"$ref": "#/$defs/roleArtifact"}}, "locator_fit_supplement": {"$ref": "#/$defs/locatorFitSupplementArtifact"}}, "additionalProperties": false}}
      },
      "additionalProperties": false
    },
    "frozen_evidence": {
      "type": "object",
      "required": ["evidence_identity", "historical_input_artifacts", "normalized_candidate", "item_inventory", "source_pages_reopened", "prose_inference_used", "semantic_judgments_added", "historical_artifacts_modified"],
      "properties": {
        "evidence_identity": {"type": "object"},
        "historical_input_artifacts": {"type": "array", "items": {"type": "object", "required": ["role", "path", "sha256", "schema_version", "disposition"], "properties": {"role": {"type": "string"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "schema_version": {"type": "string"}, "disposition": {"const": "unchanged_byte_for_byte"}}, "additionalProperties": false}},
        "normalized_candidate": {"$ref": "#/$defs/historicalArtifact"},
        "item_inventory": {"$ref": "#/$defs/historicalArtifact"},
        "supplemental_architecture_reviews": {"type": "array", "items": {"$ref": "#/$defs/viewSupplement"}},
        "supplemental_locator_fit_supplements": {"type": "array", "items": {"$ref": "#/$defs/viewLocatorFitSupplement"}},
        "source_pages_reopened": {"const": false},
        "prose_inference_used": {"const": false},
        "semantic_judgments_added": {"type": "boolean"},
        "semantic_judgment_scope": {"enum": ["none", "supplemental_architecture_review_only", "supplemental_locator_fit_only", "supplemental_architecture_and_locator_fit"]},
        "historical_artifacts_modified": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"semantic_judgments_added": {"const": true}}, "required": ["semantic_judgments_added"]},
          "then": {
            "required": ["semantic_judgment_scope"],
            "properties": {
              "semantic_judgment_scope": {
                "enum": ["supplemental_architecture_review_only", "supplemental_locator_fit_only", "supplemental_architecture_and_locator_fit"]
              }
            }
          }
        },
        {
          "if": {"properties": {"semantic_judgments_added": {"const": false}}, "required": ["semantic_judgments_added"]},
          "then": {"properties": {"semantic_judgment_scope": {"const": "none"}, "supplemental_architecture_reviews": {"maxItems": 0}, "supplemental_locator_fit_supplements": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"semantic_judgment_scope": {"const": "supplemental_architecture_review_only"}}, "required": ["semantic_judgment_scope"]},
          "then": {"required": ["supplemental_architecture_reviews"], "properties": {"supplemental_architecture_reviews": {"minItems": 1}, "supplemental_locator_fit_supplements": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"semantic_judgment_scope": {"const": "supplemental_locator_fit_only"}}, "required": ["semantic_judgment_scope"]},
          "then": {"required": ["supplemental_locator_fit_supplements"], "properties": {"supplemental_architecture_reviews": {"maxItems": 0}, "supplemental_locator_fit_supplements": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"semantic_judgment_scope": {"const": "supplemental_architecture_and_locator_fit"}}, "required": ["semantic_judgment_scope"]},
          "then": {"required": ["supplemental_architecture_reviews", "supplemental_locator_fit_supplements"], "properties": {"supplemental_architecture_reviews": {"minItems": 1}, "supplemental_locator_fit_supplements": {"minItems": 1}}}
        }
      ],
      "additionalProperties": false
    },
    "dimension_comparison": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["dimension_id", "old_rating", "new_rating", "old_points", "new_points", "value_identical", "change_basis"],
        "properties": {
          "dimension_id": {"enum": ["meaningful_coverage", "editorial_selectivity", "conceptual_stance_fidelity", "page_reference_reliability", "findability_navigation", "mechanics_consistency"]},
          "old_rating": {"type": ["number", "null"]},
          "new_rating": {"type": ["number", "null"]},
          "old_points": {"type": ["number", "null"]},
          "new_points": {"type": ["number", "null"]},
          "value_identical": {"type": "boolean"},
          "change_basis": {"enum": ["two_axis_locator_utility", "corrected_displayed_locator_unit", "unchanged_formula_and_evidence"]}
        },
        "additionalProperties": false
      }
    },
    "precision_comparison": {"type": "object", "required": ["v6", "v7"], "properties": {"v6": {"type": "object"}, "v7": {"type": "object"}}, "additionalProperties": false},
    "gate_preservation": {
      "type": "object",
      "required": ["historical_gate_outcomes_sha256", "preserved_gate_outcomes_sha256", "historical_outcomes", "preserved_outcomes", "outcomes_equal"],
      "properties": {
        "historical_gate_outcomes_sha256": {"$ref": "#/$defs/sha256"},
        "preserved_gate_outcomes_sha256": {"$ref": "#/$defs/sha256"},
        "historical_outcomes": {"type": "array", "items": {"type": "object"}},
        "preserved_outcomes": {"type": "array", "items": {"type": "object"}},
        "outcomes_equal": {"const": true}
      },
      "additionalProperties": false
    },
    "structure_count_correction": {
      "type": "object",
      "required": ["thresholds", "path_dispositions", "removed_historical_defect_ids", "new_defects_created_from_numeric_triggers"],
      "properties": {
        "thresholds": {"type": "object"},
        "path_dispositions": {"type": "array", "items": {"$ref": "#/$defs/structurePathDisposition"}},
        "removed_historical_defect_ids": {"type": "array", "items": {"type": "string", "pattern": "^DEFECT-"}, "uniqueItems": true},
        "new_defects_created_from_numeric_triggers": {"const": false}
      },
      "additionalProperties": false
    },
    "locator_fit_supplementation": {"$ref": "#/$defs/locatorFitSupplementation"},
    "invariants": {
      "type": "object",
      "required": ["only_calculation_and_display_artifacts_rebuilt", "locator_support_and_missing_access_unchanged", "non_reliability_dimensions_unchanged_except_deterministic_structure_correction", "gates_unchanged", "representation_views_recalculated_from_own_inputs", "oxford_artifacts_modified", "formula_tuned_to_oxford_result"],
      "properties": {
        "only_calculation_and_display_artifacts_rebuilt": {"const": true},
        "locator_support_and_missing_access_unchanged": {"const": true},
        "non_reliability_dimensions_unchanged_except_deterministic_structure_correction": {"const": true},
        "gates_unchanged": {"const": true},
        "representation_views_recalculated_from_own_inputs": {"const": true},
        "supplemental_review_narrowly_scoped_and_hash_bound": {"const": true},
        "locator_fit_supplement_applied_in_memory_only": {"const": true},
        "legacy_fit_conflict_rule_id": {"const": "F-COMPAT-LEGACY-FIT-CONFLICT-TO-SUPPLEMENT-V1"},
        "legacy_fit_conflicts_routed_without_precedence": {"const": true},
        "historical_fit_classifier_records_modified": {"const": false},
        "invalid_states_supplement_eligible": {"const": false},
        "bare_loc_pos_automatically_mapped": {"const": false},
        "evaluation_specific_fit_rule_added": {"const": false},
        "evaluation_result_used_as_target": {"const": false},
        "oxford_artifacts_modified": {"const": false},
        "formula_tuned_to_oxford_result": {"const": false}
      },
      "additionalProperties": false
    },
    "migration_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["schema_version", "artifact_path", "sha256"],
      "properties": {"schema_version": {"type": "string", "minLength": 1}, "artifact_path": {"$ref": "score-migration.schema.json#/$defs/portablePath"}, "sha256": {"$ref": "#/$defs/sha256"}},
      "additionalProperties": true
    },
    "historicalArtifact": {
      "allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"calculation_sha256": {"$ref": "#/$defs/sha256"}}}]
    },
    "v7Calculation": {
      "allOf": [{"$ref": "#/$defs/artifact"}, {"required": ["calculation_sha256", "rubric_version", "calculation_profile"], "properties": {"schema_version": {"const": "subject-index-dimension-calculations-v4"}, "calculation_sha256": {"$ref": "#/$defs/sha256"}, "rubric_version": {"const": "subject-index-rubric-v7"}, "calculation_profile": {"const": "subject-index-dimension-calculation-v3"}}}]
    },
    "reviewArtifact": {
      "allOf": [{"$ref": "#/$defs/artifact"}, {"required": ["review_sha256"], "properties": {"schema_version": {"const": "subject-index-structure-locator-review-v1"}, "review_sha256": {"$ref": "#/$defs/sha256"}}}]
    },
    "supplementArtifact": {
      "allOf": [{"$ref": "#/$defs/artifact"}, {"required": ["supplement_id", "supplement_sha256"], "properties": {"schema_version": {"const": "subject-index-v7-architecture-review-supplement-v1"}, "supplement_id": {"type": "string", "pattern": "^ARCHSUP-[A-F0-9]{12}$"}, "supplement_sha256": {"$ref": "#/$defs/sha256"}}}]
    },
    "viewSupplement": {
      "type": "object",
      "required": ["view_id", "artifact"],
      "properties": {"view_id": {"type": "string", "minLength": 1}, "artifact": {"$ref": "#/$defs/supplementArtifact"}},
      "additionalProperties": false
    },
    "locatorFitSupplementArtifact": {
      "allOf": [{"$ref": "#/$defs/artifact"}, {"required": ["supplement_id", "supplement_sha256", "unresolved_set_sha256", "decision_count"], "properties": {"schema_version": {"enum": ["subject-index-v7-locator-fit-supplement-v1", "subject-index-v7-locator-fit-supplement-v2"]}, "supplement_id": {"type": "string", "pattern": "^FITSUP-[A-F0-9]{12}$"}, "supplement_sha256": {"$ref": "#/$defs/sha256"}, "unresolved_set_sha256": {"$ref": "#/$defs/sha256"}, "decision_count": {"type": "integer", "minimum": 1}}}]
    },
    "viewLocatorFitSupplement": {
      "type": "object",
      "required": ["view_id", "artifact"],
      "properties": {"view_id": {"type": "string", "minLength": 1}, "artifact": {"$ref": "#/$defs/locatorFitSupplementArtifact"}},
      "additionalProperties": false
    },
    "legacyFitClassification": {
      "type": "object",
      "required": ["locator_id", "path_id", "compatibility_rule_id", "fit_category", "fit_rule_id", "applicable_structured_defect_ids", "prose_inference_used"],
      "properties": {
        "locator_id": {"type": "string", "pattern": "^LOC-"},
        "path_id": {"type": "string", "pattern": "^PATH-"},
        "fit_category": {"enum": ["material_mismatch", "severe_mismatch", "no_fit"]},
        "fit_rule_id": {"enum": ["F-MINOR-MISMATCH-035", "F-MAJOR-MISMATCH-015", "F-NO-FIT-000"]},
        "compatibility_rule_id": {"const": "F-COMPAT-LEGACY-CODE-SEVERITY-ONLY-V1"},
        "applicable_structured_defect_ids": {"type": "array", "items": {"type": "string", "pattern": "^DEFECT-"}, "uniqueItems": true},
        "prose_inference_used": {"const": false}
      },
      "additionalProperties": false
    },
    "locatorFitSupplementation": {
      "type": "object",
      "required": ["supplemental_judgments_added", "scope", "views", "historical_artifacts_unchanged", "non_fit_judgments_unchanged", "numerical_fit_credit_manually_supplied", "combined_credit_manually_supplied", "grade_manually_supplied", "dimension_or_total_score_manually_supplied"],
      "properties": {
        "supplemental_judgments_added": {"type": "boolean"},
        "scope": {"enum": ["none", "complete_path_fit_only"]},
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["view_id", "unresolved_set_count_before_supplementation", "unresolved_set_count_after_supplementation", "unresolved_locator_ids", "unresolved_set_sha256", "compatibility_classifications_without_supplement", "supplement"],
            "properties": {
              "view_id": {"type": "string", "minLength": 1},
              "unresolved_set_count_before_supplementation": {"type": "integer", "minimum": 0},
              "unresolved_set_count_after_supplementation": {"const": 0},
              "unresolved_locator_ids": {"type": "array", "items": {"type": "string", "pattern": "^LOC-"}, "uniqueItems": true},
              "unresolved_records_without_supplement": {"type": "array", "items": {"$ref": "v7-locator-fit-preflight.schema.json#/$defs/unresolvedFit"}},
              "unresolved_reason_counts_without_supplement": {"$ref": "v7-locator-fit-preflight.schema.json#/$defs/unresolvedReasonCounts"},
              "preflight_group_counts": {"$ref": "v7-locator-fit-preflight.schema.json#/$defs/groupCounts"},
              "conflict_routed_locator_ids": {"type": "array", "items": {"type": "string", "pattern": "^LOC-"}, "uniqueItems": true},
              "unresolved_set_sha256": {"$ref": "#/$defs/sha256"},
              "compatibility_classifications_without_supplement": {"type": "array", "items": {"$ref": "#/$defs/legacyFitClassification"}},
              "supplement": {"oneOf": [{"$ref": "#/$defs/locatorFitSupplementArtifact"}, {"type": "null"}]}
            },
            "allOf": [
              {"if": {"properties": {"supplement": {"type": "null"}}, "required": ["supplement"]}, "then": {"properties": {"unresolved_set_count_before_supplementation": {"const": 0}, "unresolved_locator_ids": {"maxItems": 0}}}},
              {"if": {"properties": {"supplement": {"type": "object"}}, "required": ["supplement"]}, "then": {"properties": {"unresolved_set_count_before_supplementation": {"minimum": 1}, "unresolved_locator_ids": {"minItems": 1}}}}
            ],
            "additionalProperties": false
          }
        },
        "historical_artifacts_unchanged": {"const": true},
        "non_fit_judgments_unchanged": {"const": true},
        "numerical_fit_credit_manually_supplied": {"const": false},
        "combined_credit_manually_supplied": {"const": false},
        "grade_manually_supplied": {"const": false},
        "dimension_or_total_score_manually_supplied": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"supplemental_judgments_added": {"const": true}}, "required": ["supplemental_judgments_added"]},
          "then": {"properties": {"scope": {"const": "complete_path_fit_only"}, "views": {"contains": {"properties": {"supplement": {"type": "object"}}, "required": ["supplement"]}}}}
        },
        {
          "if": {"properties": {"supplemental_judgments_added": {"const": false}}, "required": ["supplemental_judgments_added"]},
          "then": {"properties": {"scope": {"const": "none"}, "views": {"items": {"properties": {"supplement": {"type": "null"}}}}}}
        }
      ],
      "additionalProperties": false
    },
    "structurePathDisposition": {
      "type": "object",
      "required": ["path_id", "displayed_locator_count", "maximum_range_span", "atomic_assignment_count", "long_displayed_locator_string_review_trigger", "long_continuous_range_review_trigger", "applicable_structured_defect_ids", "removed_structured_defect_ids", "retained_structured_defect_ids", "historical_defect_dispositions", "final_architecture_disposition", "deterministic_mapping_rule_id"],
      "properties": {
        "path_id": {"type": "string", "pattern": "^PATH-"},
        "displayed_locator_count": {"type": "integer", "minimum": 1},
        "maximum_range_span": {"type": ["integer", "null"], "minimum": 0},
        "atomic_assignment_count": {"type": ["integer", "null"], "minimum": 1},
        "long_displayed_locator_string_review_trigger": {"type": ["boolean", "null"]},
        "long_continuous_range_review_trigger": {"type": ["boolean", "null"]},
        "applicable_structured_defect_ids": {"$ref": "structure-locator-review-v1.schema.json#/$defs/defectIds"},
        "removed_structured_defect_ids": {"$ref": "structure-locator-review-v1.schema.json#/$defs/defectIds"},
        "retained_structured_defect_ids": {"$ref": "structure-locator-review-v1.schema.json#/$defs/defectIds"},
        "historical_defect_dispositions": {"type": "array", "items": {"$ref": "structure-locator-review-v1.schema.json#/$defs/historicalDefectDisposition"}},
        "final_architecture_disposition": {"enum": ["derivation_failed", "historical_false_positive_removed", "structured_defect_confirmed", "reviewed_no_defect", "review_required", "historical_defect_retained", "independent_architecture_disposition_retained", "no_numeric_review_trigger"]},
        "deterministic_mapping_rule_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "roleArtifact": {
      "type": "object",
      "required": ["role", "schema_version", "artifact_path", "sha256"],
      "properties": {"role": {"type": "string"}, "schema_version": {"type": "string"}, "artifact_path": {"$ref": "score-migration.schema.json#/$defs/portablePath"}, "sha256": {"$ref": "#/$defs/sha256"}},
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"tool": {"properties": {"version": {"const": "dimension-score-cli-v7.0.3"}}, "required": ["version"]}}, "required": ["tool"]},
      "then": {
        "required": ["locator_fit_supplementation"],
        "properties": {
          "frozen_evidence": {"required": ["supplemental_locator_fit_supplements"]},
          "invariants": {"required": ["locator_fit_supplement_applied_in_memory_only", "evaluation_specific_fit_rule_added", "evaluation_result_used_as_target"]}
        }
      }
    },
    {
      "if": {"properties": {"tool": {"properties": {"version": {"enum": ["dimension-score-cli-v7.0.4", "dimension-score-cli-v7.0.5", "dimension-score-cli-v7.0.6", "dimension-score-cli-v7.1.0"]}}, "required": ["version"]}}, "required": ["tool"]},
      "then": {
        "required": ["locator_fit_supplementation"],
        "properties": {
          "frozen_evidence": {"required": ["supplemental_locator_fit_supplements"]},
          "locator_fit_supplementation": {
            "properties": {
              "views": {
                "items": {
                  "required": ["unresolved_records_without_supplement", "unresolved_reason_counts_without_supplement", "preflight_group_counts", "conflict_routed_locator_ids"]
                }
              }
            }
          },
          "invariants": {
            "required": ["locator_fit_supplement_applied_in_memory_only", "legacy_fit_conflict_rule_id", "legacy_fit_conflicts_routed_without_precedence", "historical_fit_classifier_records_modified", "invalid_states_supplement_eligible", "bare_loc_pos_automatically_mapped", "evaluation_specific_fit_rule_added", "evaluation_result_used_as_target"]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
