{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v6-projection-metadata.schema.json",
  "title": "V6 result and web projection metadata",
  "type": "object",
  "required": ["schema_version", "candidate_label", "inclusion_policy", "uncertainty_policy", "critical_gates"],
  "properties": {
    "schema_version": {"const": "subject-index-v6-projection-metadata-v1"},
    "candidate_label": {"type": "string", "minLength": 1},
    "inclusion_policy": {"type": "string", "minLength": 1},
    "uncertainty_policy": {"type": "string", "minLength": 1},
    "critical_gates": {"type": "array", "items": {"type": "object"}},
    "report_id": {"type": "string"},
    "headline": {"type": "string"},
    "summary": {"type": "string"},
    "interpretation": {"type": "string"},
    "defect_counts": {"type": "object"},
    "strengths": {"type": "array", "items": {"type": "object"}},
    "defects": {"type": "array", "items": {"type": "object"}},
    "examples": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "counterfactual_score_views": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["view_id", "label", "calculation", "provenance_artifacts"],
        "properties": {
          "view_id": {"type": "string", "minLength": 1, "not": {"const": "canonical_as_delivered"}},
          "label": {"type": "string", "minLength": 1},
          "calculation": {"$ref": "#/$defs/calculationReference"},
          "provenance_artifacts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/artifactReference"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifactReference": {
      "type": "object",
      "required": ["role", "schema_version", "artifact_path", "sha256"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "artifact_path": {"$ref": "score-migration.schema.json#/$defs/portablePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "calculationReference": {
      "type": "object",
      "required": ["schema_version", "artifact_path", "sha256", "calculation_sha256", "rubric_version", "calculation_profile"],
      "properties": {
        "schema_version": {"const": "subject-index-dimension-calculations-v2"},
        "artifact_path": {"$ref": "score-migration.schema.json#/$defs/portablePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "calculation_sha256": {"$ref": "#/$defs/sha256"},
        "rubric_version": {"const": "subject-index-rubric-v6"},
        "calculation_profile": {"const": "subject-index-dimension-calculation-v2"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
