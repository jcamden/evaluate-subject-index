{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-preparation-integration.schema.json",
  "title": "Candidate-preparation integration transaction report",
  "type": "object",
  "required": ["schema_version", "status", "integrated_at", "evaluation_id", "candidate_id", "candidate_sha256", "preparation_receipt_sha256", "benchmark_lock_sha256", "selection", "merged_commit", "worker_head_commit", "premerge_evidence_sha256", "merge_evidence_sha256", "benchmark_proof_sha256", "public_changed_paths", "normalized_candidate_file_sha256", "item_inventory_file_sha256", "transaction_order", "benchmark_repository_modified"],
  "properties": {
    "schema_version": {"const": "candidate-preparation-integration-v1"},
    "status": {"const": "integrated"},
    "integrated_at": {"type": "string", "minLength": 1},
    "evaluation_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "preparation_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark_lock_sha256": {"$ref": "#/$defs/sha256"},
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {"type": {"const": "pull_request"}, "value": {"type": "integer", "minimum": 1}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {"type": {"const": "branch"}, "value": {"type": "string", "pattern": "^candidate-preparation/"}},
          "additionalProperties": false
        }
      ]
    },
    "merged_commit": {"$ref": "#/$defs/commit"},
    "worker_head_commit": {"$ref": "#/$defs/commit"},
    "premerge_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "merge_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark_proof_sha256": {"$ref": "#/$defs/sha256"},
    "public_changed_paths": {"$ref": "#/$defs/publicPaths"},
    "normalized_candidate_file_sha256": {"$ref": "#/$defs/sha256"},
    "item_inventory_file_sha256": {"$ref": "#/$defs/sha256"},
    "transaction_order": {
      "type": "array",
      "prefixItems": [
        {"const": "copy_exact_normalized_bytes"},
        {"const": "write_benchmark_lock_and_integration_evidence"},
        {"const": "update_manifest"},
        {"const": "update_state_last"},
        {"const": "validate_complete_state"},
        {"const": "create_cumulative_checkpoint"}
      ],
      "minItems": 6,
      "maxItems": 6
    },
    "benchmark_repository_modified": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "publicPaths": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["candidate/candidate-ref.json", "candidate/layout-profile.json", "validation/candidate-preparation-report.json"]},
      "allOf": [
        {"contains": {"const": "candidate/candidate-ref.json"}},
        {"contains": {"const": "candidate/layout-profile.json"}},
        {"contains": {"const": "validation/candidate-preparation-report.json"}}
      ]
    }
  },
  "additionalProperties": false
}
