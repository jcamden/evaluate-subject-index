{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "item-inventory-v2.schema.json",
  "title": "Stable display-item inventory for candidate-index-v2",
  "type": "object",
  "required": ["schema_version", "candidate_id", "candidate_sha256", "paths", "heading_nodes", "locators", "cross_references", "counts"],
  "properties": {
    "schema_version": {"const": "subject-index-item-inventory-v2"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path_id", "record_id", "record_type", "heading_path", "node_ids", "locator_ids", "reference_ids"],
        "properties": {
          "path_id": {"type": "string", "pattern": "^PATH-"},
          "record_id": {"type": "string", "pattern": "^REC-"},
          "record_type": {"enum": ["page_bearing", "container", "cross_reference", "mixed", "unresolved"]},
          "heading_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "node_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^NODE-"}, "uniqueItems": true},
          "locator_ids": {"type": "array", "items": {"type": "string", "pattern": "^LOC-"}, "uniqueItems": true},
          "reference_ids": {"type": "array", "items": {"type": "string", "pattern": "^XREF-"}, "uniqueItems": true}
        },
        "additionalProperties": true
      }
    },
    "heading_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "level", "role", "label", "heading_path", "parent_node_id", "path_ids", "record_ids", "direct_path_ids"],
        "properties": {
          "node_id": {"type": "string", "pattern": "^NODE-"},
          "level": {"type": "integer", "minimum": 1},
          "role": {"enum": ["main_heading", "subheading"]},
          "label": {"type": "string"},
          "heading_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "parent_node_id": {"type": ["string", "null"], "pattern": "^NODE-"},
          "path_ids": {"type": "array", "items": {"type": "string", "pattern": "^PATH-"}, "uniqueItems": true},
          "record_ids": {"type": "array", "items": {"type": "string", "pattern": "^REC-"}, "uniqueItems": true},
          "direct_path_ids": {"type": "array", "items": {"type": "string", "pattern": "^PATH-"}, "uniqueItems": true}
        },
        "additionalProperties": true
      }
    },
    "locators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["locator_id", "path_id", "node_ids", "source_page_label", "document_page", "mapping_status"],
        "properties": {
          "locator_id": {"type": "string", "pattern": "^LOC-"},
          "path_id": {"type": "string", "pattern": "^PATH-"},
          "node_ids": {"type": "array", "items": {"type": "string", "pattern": "^NODE-"}, "uniqueItems": true},
          "source_page_label": {"type": ["string", "null"]},
          "document_page": {"type": ["integer", "null"], "minimum": 1},
          "mapping_status": {"enum": ["resolved", "unresolved", "ambiguous"]}
        },
        "additionalProperties": true
      }
    },
    "cross_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reference_id", "record_id", "source_path_id", "source_node_id", "reference_type", "target_display", "target_path_id"],
        "properties": {
          "reference_id": {"type": "string", "pattern": "^XREF-"},
          "record_id": {"type": "string", "pattern": "^REC-"},
          "source_path_id": {"type": "string", "pattern": "^PATH-"},
          "source_node_id": {"type": "string", "pattern": "^NODE-"},
          "reference_type": {"enum": ["see", "see also"]},
          "target_display": {"type": "string"},
          "target_path_id": {"type": ["string", "null"], "pattern": "^PATH-"}
        },
        "additionalProperties": true
      }
    },
    "counts": {
      "type": "object",
      "required": ["paths", "heading_nodes", "locators", "cross_references"],
      "properties": {
        "paths": {"type": "integer", "minimum": 0},
        "heading_nodes": {"type": "integer", "minimum": 0},
        "locators": {"type": "integer", "minimum": 0},
        "cross_references": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  },
  "additionalProperties": true
}
