{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-preparation-receipt.schema.json",
  "title": "Private candidate-preparation worker receipt",
  "type": "object",
  "required": ["schema_version", "receipt_id", "receipt_sha256", "created_at", "status", "candidate_id", "candidate_sha256", "file_origin", "source_identity", "page_map_sha256", "chunk_manifest_sha256", "policy_identity", "adapter_identity", "provenance", "private_artifacts", "private_recovery", "public_projection", "repositories", "publication", "benchmark_lock", "qa", "limitations"],
  "properties": {
    "schema_version": {"const": "candidate-preparation-receipt-v1"},
    "receipt_id": {"type": "string", "pattern": "^CPR-"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready_for_pull_request", "published_unmerged"]},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "file_origin": {"enum": ["delivered_pdf", "reconstructed_pdf", "transcription"]},
    "source_identity": {
      "type": "object",
      "required": ["sha256", "edition"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "edition": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "page_map_sha256": {"$ref": "#/$defs/sha256"},
    "chunk_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "policy_identity": {
      "type": "object",
      "required": ["profile", "sha256", "rubric_version", "audit_mode"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "rubric_version": {"const": "subject-index-rubric-v4"},
        "audit_mode": {"enum": ["full", "pilot"]}
      },
      "additionalProperties": false
    },
    "adapter_identity": {"type": "object"},
    "provenance": {"$ref": "candidate-ref.schema.json#/properties/provenance"},
    "private_artifacts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["artifact", "archive_path", "sha256"],
        "properties": {
          "artifact": {"enum": ["candidate_ref", "layout_profile", "layout_extraction", "candidate_index", "item_inventory", "normalization_exceptions", "normalization_report", "normalization_qa"]},
          "archive_path": {"$ref": "#/$defs/relativePath"},
          "sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "private_recovery": {
      "type": "object",
      "required": ["purpose", "sha256", "byte_length", "bundle_metadata_sha256", "checkpoint_ref"],
      "properties": {
        "purpose": {"const": "candidate_preparation_recovery_only"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 0},
        "bundle_metadata_sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "public_projection": {
      "type": "object",
      "required": ["changed_paths", "hashes", "outgoing_safety_scan"],
      "properties": {
        "changed_paths": {"$ref": "#/$defs/publicPaths"},
        "hashes": {
          "type": "object",
          "required": ["candidate/candidate-ref.json", "candidate/layout-profile.json", "validation/candidate-preparation-report.json"],
          "properties": {
            "candidate/candidate-ref.json": {"$ref": "#/$defs/sha256"},
            "candidate/layout-profile.json": {"$ref": "#/$defs/sha256"},
            "validation/candidate-preparation-report.json": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "outgoing_safety_scan": {"const": "passed"}
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "object",
      "required": ["candidate_project", "benchmark_project", "candidate_base_commit", "candidate_default_branch", "worker_branch", "repository_mode", "bootstrap_exception", "benchmark_preparation_base_commit"],
      "properties": {
        "candidate_project": {"type": "string", "minLength": 1},
        "benchmark_project": {"type": "string", "minLength": 1},
        "candidate_base_commit": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
        "candidate_default_branch": {"type": "string", "minLength": 1},
        "worker_branch": {"type": "string", "pattern": "^candidate-preparation/"},
        "repository_mode": {"enum": ["branch_from_existing_default_head", "bootstrap_main_readme_gitignore_then_worker_branch"]},
        "bootstrap_exception": {"type": "boolean"},
        "bootstrap_commit": {"$ref": "#/$defs/commit"},
        "bootstrap_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_preparation_base_commit": {"$ref": "#/$defs/commit"}
      },
      "additionalProperties": false
    },
    "publication": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "pull_request", "head_commit"],
          "properties": {
            "status": {"const": "not_yet_published"},
            "pull_request": {"type": "null"},
            "head_commit": {"type": "null"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "pull_request", "pull_request_url", "branch", "base_branch", "base_commit", "head_commit", "changed_paths", "file_sha256", "blob_sha", "commit_count", "evidence_sha256", "observed_at", "outgoing_safety_scan"],
          "properties": {
            "status": {"const": "open_unmerged"},
            "pull_request": {"type": "integer", "minimum": 1},
            "pull_request_url": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[1-9][0-9]*$"},
            "branch": {"type": "string", "pattern": "^candidate-preparation/"},
            "base_branch": {"type": "string", "minLength": 1},
            "base_commit": {"$ref": "#/$defs/commit"},
            "head_commit": {"$ref": "#/$defs/commit"},
            "changed_paths": {"$ref": "#/$defs/publicPaths"},
            "file_sha256": {"$ref": "#/$defs/publicHashes"},
            "blob_sha": {"$ref": "#/$defs/publicBlobs"},
            "commit_count": {"const": 1},
            "evidence_sha256": {"$ref": "#/$defs/sha256"},
            "observed_at": {"type": "string", "minLength": 1},
            "outgoing_safety_scan": {"const": "passed"}
          },
          "additionalProperties": false
        }
      ]
    },
    "benchmark_lock": {
      "type": "object",
      "required": ["status", "final_commit", "benchmark_sha256"],
      "properties": {
        "status": {"const": "pending_final_benchmark"},
        "final_commit": {"type": "null"},
        "benchmark_sha256": {"type": "null"}
      },
      "additionalProperties": false
    },
    "qa": {
      "type": "object",
      "required": ["mode", "exact_set_gate", "candidate_quality_judgments_performed"],
      "properties": {
        "mode": {"const": "full"},
        "exact_set_gate": {"const": "passed"},
        "candidate_quality_judgments_performed": {"const": false}
      },
      "additionalProperties": false
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "blob": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "commit": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "publicPaths": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["candidate/candidate-ref.json", "candidate/layout-profile.json", "validation/candidate-preparation-report.json"]},
      "allOf": [
        {"contains": {"const": "candidate/candidate-ref.json"}},
        {"contains": {"const": "candidate/layout-profile.json"}},
        {"contains": {"const": "validation/candidate-preparation-report.json"}}
      ]
    },
    "publicHashes": {
      "type": "object",
      "required": ["candidate/candidate-ref.json", "candidate/layout-profile.json", "validation/candidate-preparation-report.json"],
      "properties": {
        "candidate/candidate-ref.json": {"$ref": "#/$defs/sha256"},
        "candidate/layout-profile.json": {"$ref": "#/$defs/sha256"},
        "validation/candidate-preparation-report.json": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "publicBlobs": {
      "type": "object",
      "required": ["candidate/candidate-ref.json", "candidate/layout-profile.json", "validation/candidate-preparation-report.json"],
      "properties": {
        "candidate/candidate-ref.json": {"$ref": "#/$defs/blob"},
        "candidate/layout-profile.json": {"$ref": "#/$defs/blob"},
        "validation/candidate-preparation-report.json": {"$ref": "#/$defs/blob"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
