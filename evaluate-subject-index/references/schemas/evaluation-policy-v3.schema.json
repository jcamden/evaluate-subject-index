{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-policy-v3.schema.json",
  "title": "Source-bound subject-index judgment policy decoupled from score calculation",
  "type": "object",
  "required": ["schema_version", "policy_id", "policy_profile", "source_scope", "audience", "audit_design", "content_policies", "stage_application", "density_profile", "critical_gates", "deviations", "freeze", "policy_sha256"],
  "properties": {
    "schema_version": {"const": "subject-index-evaluation-policy-v3"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_profile": {"type": "object", "required": ["id", "standard_policy_sha256"], "properties": {"id": {"const": "subject-index-standard-policy-v7"}, "standard_policy_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": true},
    "source_scope": {
      "type": "object",
      "required": ["source_sha256", "document_page_span", "page_map_sha256", "chunk_manifest_sha256", "included", "excluded", "availability", "mixed_page_rule", "word_count_basis"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "document_page_span": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "minItems": 2, "maxItems": 2},
        "page_map_sha256": {"$ref": "#/$defs/sha256"},
        "chunk_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "included": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "excluded": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "availability": {"type": "object"},
        "mixed_page_rule": {"type": "string"},
        "word_count_basis": {"const": "indexable source words only"}
      },
      "additionalProperties": true
    },
    "audience": {"type": "object", "required": ["label", "basis", "confidence", "rationale"], "properties": {"label": {"type": "string", "minLength": 1}, "basis": {"enum": ["inferred", "user_supplied"]}, "confidence": {"enum": ["high", "medium", "low"]}, "rationale": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "audit_design": {"type": "object", "required": ["mode", "candidate_blindness", "uncertainty_policy", "uninspectable_locator_rate_tolerance"], "properties": {"mode": {"enum": ["full", "pilot"]}, "candidate_blindness": {"enum": ["required", "preferred", "not_claimed"]}, "uncertainty_policy": {"type": "string", "minLength": 1}, "uninspectable_locator_rate_tolerance": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": true},
    "content_policies": {"type": "object", "minProperties": 10, "additionalProperties": {"type": "object"}},
    "stage_application": {"type": "object", "minProperties": 6},
    "density_profile": {"type": "object", "required": ["status", "measurement_level", "aggregation", "metrics", "rationale", "maximum_score_contribution"], "properties": {"status": {"const": "scored"}, "measurement_level": {"const": "chapter_or_approved_intellectual_unit"}, "aggregation": {"const": "indexable_source_word_weighted_mean"}, "metrics": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}}, "rationale": {"type": "string"}, "maximum_score_contribution": {"const": 5}}, "additionalProperties": true},
    "critical_gates": {"type": "array", "minItems": 13, "items": {"type": "object"}},
    "deviations": {"type": "array", "items": {"type": "object"}},
    "freeze": {"type": "object", "required": ["frozen_at", "candidate_seen"], "properties": {"frozen_at": {"type": "string"}, "candidate_seen": {"const": false}}, "additionalProperties": false},
    "policy_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "additionalProperties": false
}
