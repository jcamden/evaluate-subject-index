{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bundle-metadata.schema.json",
  "title": "Subject index evaluation bundle metadata",
  "type": "object",
  "required": [
    "schema_version",
    "evaluation_id",
    "profile",
    "created_at",
    "state_sha256",
    "manifest_sha256",
    "included_paths",
    "excluded"
  ],
  "properties": {
    "schema_version": {"const": "subject-index-bundle-v1"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "profile": {"enum": ["portable", "private-complete"]},
    "created_at": {"type": "string"},
    "state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "included_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
