{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bundle-metadata.schema.json",
  "title": "Subject index evaluation bundle metadata",
  "type": "object",
  "required": [
    "schema_version",
    "evaluation_id",
    "profile",
    "created_at",
    "included_paths",
    "excluded"
  ],
  "properties": {
    "schema_version": {"const": "subject-index-bundle-v2"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "profile": {"enum": ["portable", "private-complete"]},
    "created_at": {"type": "string"},
    "included_paths": {
      "type": "array",
      "items": {"$ref": "#/$defs/relativePath"},
      "uniqueItems": true
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": {"$ref": "#/$defs/relativePath"},
          "reason": {"enum": ["restricted_by_portable_profile", "export_artifact_not_nested", "not_currently_accessible"]}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"}
  },
  "additionalProperties": false
}
