{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-benchmark.schema.json",
  "title": "Frozen source subject benchmark",
  "type": "object",
  "required": ["schema_version", "benchmark_id", "version", "source_sha256", "policy_sha256", "candidate_blindness", "chunk_manifest_sha256", "subjects", "relationships", "reader_tasks", "freeze", "benchmark_sha256"],
  "properties": {
    "schema_version": {"const": "source-subject-benchmark-v2"},
    "benchmark_id": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_blindness": {"enum": ["preserved", "compromised", "not_claimed"]},
    "chunk_manifest_sha256": {"type": "string"},
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject_id", "label", "priority", "meaning", "stance", "acceptable_access", "evidence"],
        "properties": {
          "subject_id": {"type": "string", "pattern": "^SUBJ-"},
          "label": {"type": "string"},
          "priority": {"enum": ["essential", "major", "optional", "exclude_by_default"]},
          "meaning": {"type": "string"},
          "stance": {"type": "string"},
          "acceptable_access": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": true
      }
    },
    "relationships": {"type": "array", "items": {"type": "object"}},
    "reader_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "question", "subject_ids"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^TASK-"},
          "question": {"type": "string"},
          "subject_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "freeze": {
      "type": "object",
      "required": ["frozen_at", "synthesis_pass_complete", "page_coverage_complete"],
      "properties": {
        "frozen_at": {"type": "string"},
        "synthesis_pass_complete": {"const": true},
        "page_coverage_complete": {"const": true}
      }
    },
    "benchmark_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
